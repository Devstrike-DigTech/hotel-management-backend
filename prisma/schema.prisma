// ===========================================================================
// M6: Enterprise tier and the hardened platform console.
//
// "Control plane" tables live only in the shared (platform) database, even
// for tenants with a dedicated database: platform users and sessions, the
// platform audit log, coupons, announcements, support desk, impersonation,
// offboarding, exports, API keys and usage, white-label settings, SSO, the
// dedicated-database registry and the public listing projection.
// Webhook endpoints and deliveries are tenant data ("data plane") and move
// with the tenant. See the *_m6_enterprise migration for RLS and grants.
// ===========================================================================

model PlatformRecoveryCode {
  id             String    @id @default(uuid()) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  codeHash       String    @map("code_hash")
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("platform_recovery_codes")
}

model PlatformSession {
  id             String    @id @default(uuid()) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  ip             String?
  userAgent      String?   @map("user_agent")
  mfaMethod      String    @default("totp") @map("mfa_method")
  stepUpAt       DateTime? @map("step_up_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason   String?   @map("revoke_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          PlatformUser           @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  refreshTokens PlatformRefreshToken[]

  @@index([platformUserId, createdAt(sort: Desc)])
  @@map("platform_sessions")
}

/// Opaque rotating refresh tokens of a platform session (HMAC stored).
model PlatformRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session PlatformSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("platform_refresh_tokens")
}

/// Append-only log of every platform action (triggers refuse UPDATE / DELETE).
model PlatformAuditLog {
  id                  String   @id @default(uuid()) @db.Uuid
  actorPlatformUserId String?  @map("actor_platform_user_id") @db.Uuid
  actorName           String?  @map("actor_name")
  actorRole           String?  @map("actor_role")
  action              String
  targetType          String?  @map("target_type")
  targetId            String?  @map("target_id")
  /// Tenant the action concerned (no FK: tenants may be purged, history stays).
  tenantId            String?  @map("tenant_id") @db.Uuid
  method              String?
  path                String?
  statusCode          Int?     @map("status_code")
  ip                  String?
  userAgent           String?  @map("user_agent")
  sessionId           String?  @map("session_id") @db.Uuid
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([actorPlatformUserId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("platform_audit_logs")
}

model Coupon {

model LoyaltyMember {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  guestId        String   @unique @map("guest_id") @db.Uuid
  memberNo       String   @map("member_no")

/// Hotel guest. `idNumberEnc` is AES-256-GCM ciphertext (GUEST_DATA_KEY);
/// only the last four digits are kept in clear for masking. Deduplicated by
/// phone per tenant (NULL after NDPA anonymisation).
model Guest {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  fullName           String    @map("full_name")
  phone              String?
  email              String?
  gender             Gender?
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  nationality        String    @default("Nigerian")
  address            String?
  idType             IdType?   @map("id_type")
  idNumberEnc        String?   @map("id_number_enc")
  idNumberLast4      String?   @map("id_number_last4")
  idImageKey         String?   @map("id_image_key")
  idImageContentType String?   @map("id_image_content_type")
  vehiclePlate       String?   @map("vehicle_plate")
  company            String?
  vip                Boolean   @default(false)
  notes              String    @default("")
  consentAt          DateTime? @map("consent_at") @db.Timestamptz(3)
  marketingOptIn     Boolean   @default(false) @map("marketing_opt_in")
  anonymisedAt       DateTime? @map("anonymised_at") @db.Timestamptz(3)
  /// Platform-level guest account (guest_accounts.id) linked by verified phone. No FK: that table is platform-only.
  guestAccountId     String?   @map("guest_account_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  folios       Folio[]
  reviews      Review[]
  loyalty      LoyaltyMember?

  @@unique([tenantId, phone])
  @@index([guestAccountId])
  @@index([tenantId, fullName])
  @@map("guests")
}

/// A stay. Overlap on the same room is prevented by the exclusion constraint
/// `reservations_no_overlap` (btree_gist) for PENDING, CONFIRMED, CHECKED_IN.
model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  propertyId      String            @map("property_id") @db.Uuid
  code            String
  guestId         String            @map("guest_id") @db.Uuid
  roomTypeId      String            @map("room_type_id") @db.Uuid
  roomId          String?           @map("room_id") @db.Uuid
  stayType        StayType          @default(NIGHTLY) @map("stay_type")
  arrivalAt       DateTime          @map("arrival_at") @db.Timestamptz(3)
  departureAt     DateTime          @map("departure_at") @db.Timestamptz(3)
  adults          Int               @default(1)
  children        Int               @default(0)
  source          ReservationSource @default(WALK_IN)
  status          ReservationStatus @default(CONFIRMED)
  rateKobo        BigInt            @map("rate_kobo")
  notes           String            @default("")
  createdById     String?           @map("created_by_id") @db.Uuid
  checkedInAt     DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  checkedInById   String?           @map("checked_in_by_id") @db.Uuid
  checkedOutAt    DateTime?         @map("checked_out_at") @db.Timestamptz(3)
  checkedOutById  String?           @map("checked_out_by_id") @db.Uuid
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?           @map("cancel_reason")
  noShowAt        DateTime?         @map("no_show_at") @db.Timestamptz(3)
  clientCreatedAt DateTime?         @map("client_created_at") @db.Timestamptz(3)

  // Guest register entry (police / security book).
  regArrivingFrom           String?       @map("reg_arriving_from")
  regGoingTo                String?       @map("reg_going_to")
  regPurpose                VisitPurpose? @map("reg_purpose")
  regVehiclePlate           String?       @map("reg_vehicle_plate")
  registrationCompletedAt   DateTime?     @map("registration_completed_at") @db.Timestamptz(3)
  registrationCompletedById String?       @map("registration_completed_by_id") @db.Uuid

  // M3: online bookings (null for desk bookings).
  paymentMode         PaymentMode?   @map("payment_mode")
  guaranteeType       GuaranteeType? @map("guarantee_type")
  holdExpiresAt       DateTime?      @map("hold_expires_at") @db.Timestamptz(3)
  commissionBps       Int?           @map("commission_bps")
  quotedTotalKobo     BigInt?        @map("quoted_total_kobo")
  /// Nonce of the quote token the booking was made from (idempotent retries).
  quoteRef            String?        @map("quote_ref")
  /// PriceBreakdown snapshot the guest accepted.
  quote               Json?
  contactPhone        String?        @map("contact_phone")
  contactEmail        String?        @map("contact_email")
  specialRequests     String         @default("") @map("special_requests")
  guestAccountId      String?        @map("guest_account_id") @db.Uuid
  cancelledBy         CancelledBy?   @map("cancelled_by")
  cancellationFeeKobo BigInt?        @map("cancellation_fee_kobo")

  // M4: rates, promotions, corporate.
  ratePlanId         String? @map("rate_plan_id") @db.Uuid
  promoCodeId        String? @map("promo_code_id") @db.Uuid
  corporateAccountId String? @map("corporate_account_id") @db.Uuid
  /// Per-night price snapshot: { date, rateKobo, baseRateKobo, source, ruleId, ruleName, discountKobo }[].
  nightlyRates       Json    @default("[]") @map("nightly_rates")
  /// Cancellation policy of the rate plan at booking (null = hotel policy).
  cancelPolicy       Json?   @map("cancel_policy")

  // M5: channel manager, guest inbox, loyalty.
  otaChannel          OtaChannel? @map("ota_channel")
  otaRef              String?     @map("ota_ref")
  otaCommissionKobo   BigInt?     @map("ota_commission_kobo")
  overbooked          Boolean     @default(false)
  expectedArrivalTime String?     @map("expected_arrival_time")
  /// Points redeemed on this stay (online redemption held at booking).
  loyaltyPoints       Int         @default(0) @map("loyalty_points")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest             Guest              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room              Room?              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  folio             Folio?
  housekeepingTasks HousekeepingTask[]
  guardFlags        GuardFlag[]
  bookingPayments   BookingPayment[]
  bookingRefunds    BookingRefund[]
  commissionEntries CommissionEntry[]
  review            Review?
  notificationLogs  NotificationLog[]
  ratePlan          RatePlan?          @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)
  promoCode         PromoCode?         @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  corporateAccount  CorporateAccount?  @relation(fields: [corporateAccountId], references: [id], onDelete: Restrict)
  promoRedemption   PromoRedemption?
  cityLedgerCharges CityLedgerCharge[]

  @@unique([tenantId, code])
  @@unique([tenantId, quoteRef])
  @@index([guestAccountId])
  @@index([status, holdExpiresAt])
  @@index([tenantId, status])
  @@index([tenantId, arrivalAt])
  @@index([tenantId, departureAt])
  @@index([guestId])
  @@index([roomTypeId])
  @@index([roomId])
  @@index([propertyId, arrivalAt])
  @@map("reservations")
}

model Folio {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  propertyId    String      @map("property_id") @db.Uuid
  kind          FolioKind   @default(RESERVATION)
  status        FolioStatus @default(OPEN)
  reservationId String?     @unique @map("reservation_id") @db.Uuid
  guestId       String?     @map("guest_id") @db.Uuid
  name          String
  notes         String      @default("")
  createdById   String?     @map("created_by_id") @db.Uuid
  closedAt      DateTime?   @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation?   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guest       Guest?         @relation(fields: [guestId], references: [id], onDelete: Restrict)
  entries     FolioEntry[]
  invoices    GuestInvoice[]
  receipts    Receipt[]

  @@index([tenantId, status])
  @@index([propertyId, status])
  @@map("folios")
}

/// Immutable ledger line (trigger blocks UPDATE/DELETE). Corrections are VOID
/// entries; `refEntryId` is unique, so an entry can be voided only once.
model FolioEntry {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  propertyId      String         @map("property_id") @db.Uuid
  folioId         String         @map("folio_id") @db.Uuid
  type            FolioEntryType
  amountKobo      BigInt         @map("amount_kobo")
  description     String
  businessDate    DateTime       @map("business_date") @db.Date
  parentEntryId   String?        @map("parent_entry_id") @db.Uuid
  refEntryId      String?        @unique @map("ref_entry_id") @db.Uuid
  taxCode         TaxCode?       @map("tax_code")
  rateBps         Int?           @map("rate_bps")
  inclusive       Boolean?
  paymentMethod   PaymentMethod? @map("payment_method")
  paymentRef      String?        @map("payment_ref")
  shiftId         String?        @map("shift_id") @db.Uuid
  reason          String?
  approvedById    String?        @map("approved_by_id") @db.Uuid
  createdById     String?        @map("created_by_id") @db.Uuid
  clientCreatedAt DateTime?      @map("client_created_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  folio    Folio         @relation(fields: [folioId], references: [id], onDelete: Restrict)
  shift    CashierShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  receipt  Receipt?

  @@index([folioId, createdAt])
  @@index([tenantId, businessDate])
  @@index([tenantId, type, createdAt])
  @@index([shiftId])
  @@index([parentEntryId])
  @@index([propertyId, businessDate])
  @@map("folio_entries")
}

/// Gapless per-tenant, per-year document numbers. Incremented with
/// `INSERT .. ON CONFLICT DO UPDATE .. RETURNING` inside the issuing
/// transaction: the row lock serialises issuers and a rollback returns the
/// number, so there are no gaps.
model DocumentCounter {
  tenantId  String              @map("tenant_id") @db.Uuid
  kind      DocumentCounterKind
  year      Int
  /// '' for group-wide series; the property id for per-property series (invoices, receipts, POS).
  scope     String              @default("")
  lastValue Int                 @default(0) @map("last_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, kind, year, scope])
  @@map("document_counters")
}

model GuestInvoice {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  propertyId      String           @map("property_id") @db.Uuid
  folioId         String           @map("folio_id") @db.Uuid

  propertyId   String           @map("property_id") @db.Uuid
  businessDate DateTime         @map("business_date") @db.Date
  status       NightAuditStatus @default(RUNNING)
  trigger      JobTrigger       @default(SCHEDULED)
  startedAt    DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?        @map("finished_at") @db.Timestamptz(3)
  summary      Json?
  error        String?
  runById      String?          @map("run_by_id") @db.Uuid
  runByName    String?          @map("run_by_name")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, businessDate])
  @@index([tenantId, businessDate])
  @@map("night_audit_runs")
}

/// Snapshot of the daily flash report, written by the night audit.
model DailyStat {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  propertyId        String   @map("property_id") @db.Uuid
  date              DateTime @db.Date
  roomsAvailable    Int      @map("rooms_available")
  roomsSold         Int      @map("rooms_sold")
  occupancyRate     Float    @map("occupancy_rate")
  adrKobo           BigInt   @map("adr_kobo")
  revparKobo        BigInt   @map("revpar_kobo")
  roomRevenueKobo   BigInt   @map("room_revenue_kobo")
  totalRevenueKobo  BigInt   @map("total_revenue_kobo")
  paymentsTotalKobo BigInt   @map("payments_total_kobo")
  dayUseCount       Int      @map("day_use_count")
  /// Full DailyFlash payload (see API contract).
  data              Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@index([tenantId, date])
  @@map("daily_stats")
}

model HousekeepingTask {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  propertyId      String                 @map("property_id") @db.Uuid
  roomId          String                 @map("room_id") @db.Uuid
  reservationId   String?                @map("reservation_id") @db.Uuid
  status          HousekeepingTaskStatus @default(OPEN)
  reason          HousekeepingTaskReason @default(CHECKOUT)
  type            HousekeepingTaskType   @default(CHECKOUT_CLEAN)
  priority        TaskPriority           @default(NORMAL)
  /// Lagos date the task belongs to.
  businessDate    DateTime               @default(dbgenerated("(now() AT TIME ZONE 'Africa/Lagos')::date")) @map("business_date") @db.Date
  assigneeId      String?                @map("assignee_id") @db.Uuid
  assigneeName    String?                @map("assignee_name")
  dueAt           DateTime?              @map("due_at") @db.Timestamptz(3)
  startedAt       DateTime?              @map("started_at") @db.Timestamptz(3)
  /// Snapshot of the checklist: { id, label, done }[].
  checklist       Json                   @default("[]")
  /// { key, uploadedAt }[] (object storage keys).
  photos          Json                   @default("[]")
  inspectedAt     DateTime?              @map("inspected_at") @db.Timestamptz(3)
  inspectedById   String?                @map("inspected_by_id") @db.Uuid
  inspectedByName String?                @map("inspected_by_name")
  inspectionNote  String?                @map("inspection_note")
  skippedReason   String?                @map("skipped_reason")
  clientCreatedAt DateTime?              @map("client_created_at") @db.Timestamptz(3)
  notes           String                 @default("")
  completedAt     DateTime?              @map("completed_at") @db.Timestamptz(3)
  completedById   String?                @map("completed_by_id") @db.Uuid
  completedByName String?                @map("completed_by_name")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room        Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservation Reservation?        @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  tickets     MaintenanceTicket[]

  @@index([tenantId, status])
  @@index([tenantId, businessDate])
  @@index([assigneeId])
  @@index([propertyId, businessDate])
  @@map("housekeeping_tasks")
}

/// Stored responses for the Idempotency-Key header (72h).
model IdempotencyKey {
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  fingerprint    String
  completed      Boolean  @default(false)
  /// Set inside the request's business transaction(s) that wrote data, so it
  /// commits or rolls back with them: an applied key is never executed again.
  applied        Boolean  @default(false)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ===========================================================================
// M3: online booking, payments, commission, guests, reviews, notifications
// ===========================================================================

enum PaymentMode {
  ONLINE
  PAY_AT_HOTEL
}

enum GuaranteeType {
  NONE
  PREPAID
}

enum CancelledBy {
  GUEST
  HOTEL
  SYSTEM
}

enum BookingPaymentStatus {
  INITIALIZED
  SUCCEEDED
  FAILED
  ORPHANED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrphanReason {
  LATE_NO_INVENTORY
  AMOUNT_MISMATCH
  BOOKING_CANCELLED
  DUPLICATE_PAYMENT
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RefundReason {
  GUEST_CANCELLED
  HOTEL_CANCELLED
  PAYMENT_ORPHANED
}

enum CommissionKind {
  ACCRUED
  COLLECTED
  REVERSED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum TravellerType {
  BUSINESS
  COUPLE
  FAMILY
  SOLO
  FRIENDS
}

enum ModerationReason {
  ABUSE
  PII
  SPAM
  OFF_TOPIC
  OTHER
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  OUTBOX
}

enum NotificationAudience {
  GUEST
  HOTEL
  PLATFORM
}

enum GuestChallengeKind {
  OTP
  MAGIC_LINK
}

/// One Paystack transaction attempt for an online booking. `reference` is
/// globally unique; the webhook finds the booking through it.
model BookingPayment {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  propertyId            String               @map("property_id") @db.Uuid
  reservationId         String               @map("reservation_id") @db.Uuid
  reference             String               @unique
  provider              String               @default("paystack")
  status                BookingPaymentStatus @default(INITIALIZED)
  amountKobo            BigInt               @map("amount_kobo")
  commissionKobo        BigInt               @map("commission_kobo")
  commissionBps         Int                  @map("commission_bps")
  currency              String               @default("NGN")
  subaccountCode        String?              @map("subaccount_code")
  authorizationUrl      String?              @map("authorization_url")
  accessCode            String?              @map("access_code")
  callbackUrl           String               @map("callback_url")
  email                 String
  paidAmountKobo        BigInt?              @map("paid_amount_kobo")
  paidAt                DateTime?            @map("paid_at") @db.Timestamptz(3)
  channel               String?
  providerTransactionId String?              @map("provider_transaction_id")
  orphanReason          OrphanReason?        @map("orphan_reason")
  folioEntryId          String?              @map("folio_entry_id") @db.Uuid
  lastVerifiedAt        DateTime?            @map("last_verified_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  refunds     BookingRefund[]
  commission  CommissionEntry[]

  @@index([tenantId, createdAt])
  @@index([reservationId])
  @@index([status])
  @@map("booking_payments")
}

model BookingRefund {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  reservationId    String       @map("reservation_id") @db.Uuid
  amountKobo       BigInt       @map("amount_kobo")
  reason           RefundReason
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @map("provider_refund_id")
  error            String?
  attempts         Int          @default(0)
  requestedBy      String?      @map("requested_by")
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment     BookingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reservation Reservation    @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([paymentId])
  @@index([status])
  @@map("booking_refunds")
}

/// Platform commission per online booking. Amounts are positive; the net
/// commission is COLLECTED + ACCRUED - REVERSED. `accrual` tells a REVERSED
/// entry which side it reduces.
model CommissionEntry {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  propertyId    String            @map("property_id") @db.Uuid
  reservationId String            @map("reservation_id") @db.Uuid
  paymentId     String?           @map("payment_id") @db.Uuid
  kind          CommissionKind
  /// For REVERSED: true when it reverses an ACCRUED (receivable) entry.
  accrual       Boolean           @default(false)
  amountKobo    BigInt            @map("amount_kobo")
  baseKobo      BigInt            @map("base_kobo")
  commissionBps Int               @map("commission_bps")
  channel       ReservationSource
  note          String?
  settledAt     DateTime?         @map("settled_at") @db.Timestamptz(3)
  settlementRef String?           @map("settlement_ref")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  payment     BookingPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([reservationId])
  @@map("commission_entries")
}

/// Hotel payout bank account and its Paystack subaccount.
model PayoutAccount {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  propertyId         String   @unique @map("property_id") @db.Uuid
  bankCode           String   @map("bank_code")
  bankName           String   @map("bank_name")
  /// AES-256-GCM ciphertext (GUEST_DATA_KEY), tenant id as associated data.
  accountNumberEnc   String   @map("account_number_enc")
  accountNumberLast4 String   @map("account_number_last4")
  accountName        String   @map("account_name")
  businessName       String   @map("business_name")
  subaccountCode     String   @map("subaccount_code")
  provider           String   @default("paystack")
  settlementVerified Boolean  @default(false) @map("settlement_verified")
  percentageCharge   Float    @default(0) @map("percentage_charge")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payout_accounts")
}

/// Verified-stay review: one per checked-out reservation.
model Review {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  propertyId       String            @map("property_id") @db.Uuid
  reservationId    String            @unique @map("reservation_id") @db.Uuid
  guestId          String            @map("guest_id") @db.Uuid
  guestAccountId   String?           @map("guest_account_id") @db.Uuid
  overall          Int
  cleanliness      Int
  service          Int
  location         Int
  value            Int
  title            String?
  body             String
  stayMonth        String            @map("stay_month")
  travellerType    TravellerType     @map("traveller_type")
  displayName      String            @map("display_name")
  status           ReviewStatus      @default(PUBLISHED)
  hotelReply       String?           @map("hotel_reply")
  hotelRepliedAt   DateTime?         @map("hotel_replied_at") @db.Timestamptz(3)
  hotelRepliedById String?           @map("hotel_replied_by_id") @db.Uuid
  flaggedReason    String?           @map("flagged_reason")
  flaggedAt        DateTime?         @map("flagged_at") @db.Timestamptz(3)
  hiddenReason     ModerationReason? @map("hidden_reason")
  moderationNote   String?           @map("moderation_note")
  moderatedAt      DateTime?         @map("moderated_at") @db.Timestamptz(3)
  moderatedBy      String?           @map("moderated_by")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guest       Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@index([propertyId, status, createdAt(sort: Desc)])
  @@index([tenantId, createdAt])
  @@index([status])
  @@map("reviews")
}

/// Every guest / hotel / platform message. Tenant-scoped when it concerns a
/// hotel (RLS); OTP and magic-link rows have no tenant and are visible to the
/// platform role only.
model NotificationLog {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String?              @map("tenant_id") @db.Uuid
  reservationId     String?              @map("reservation_id") @db.Uuid
  guestAccountId    String?              @map("guest_account_id") @db.Uuid
  template          String
  channel           NotificationChannel
  audience          NotificationAudience @default(GUEST)
  recipient         String
  subject           String?
  bodyText          String               @map("body_text")
  bodyHtml          String?              @map("body_html")
  status            NotificationStatus   @default(QUEUED)
  provider          String
  providerMessageId String?              @map("provider_message_id")
  attempts          Int                  @default(0)
  error             String?
  /// M4: approved WhatsApp template and parameters ({ name, language, params }) used outside the 24-hour window.
  waTemplate        Json?                @map("wa_template")
  /// e.g. "PRE_ARRIVAL:<reservationId>:EMAIL"; unique so scheduled messages go out once.
  dedupeKey         String?              @unique @map("dedupe_key")
  sentAt            DateTime?            @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([reservationId])
  @@index([status])
  @@map("notification_logs")
}

// ---------------------------------------------------------------------------
// Platform-level guest identity (hotel_platform only; no hotel_app grants)
// ---------------------------------------------------------------------------

model GuestAccount {
  id             String    @id @default(uuid()) @db.Uuid
  phone          String    @unique
  email          String?
  fullName       String    @default("") @map("full_name")
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens GuestRefreshToken[]

  @@index([email])
  @@map("guest_accounts")
}

/// OTP (6 digits) or magic-link challenge. Only an HMAC of the secret is stored.
model GuestOtpChallenge {
  id          String             @id @default(uuid()) @db.Uuid
  kind        GuestChallengeKind @default(OTP)
  phone       String?
  email       String?
  channel     String
  codeHash    String             @map("code_hash")
  attempts    Int                @default(0)
  maxAttempts Int                @default(5) @map("max_attempts")
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?          @map("consumed_at") @db.Timestamptz(3)
  lockedAt    DateTime?          @map("locked_at") @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([email, createdAt])
  @@map("guest_otp_challenges")
}

model GuestRefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  guestAccountId String    @map("guest_account_id") @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason   String?   @map("revoke_reason")
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account GuestAccount @relation(fields: [guestAccountId], references: [id], onDelete: Cascade)

  @@index([guestAccountId])
  @@index([familyId])
  @@map("guest_refresh_tokens")
}

// ===========================================================================
// M4: permissions, housekeeping, maintenance, rates, promotions, corporate,

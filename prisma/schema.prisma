// Prisma schema for the multi-tenant hotel management platform.
//
// Every tenant-scoped table carries a `tenant_id` column and is protected by
// PostgreSQL Row-Level Security (see prisma/migrations/*_rls). The runtime
// role `hotel_app` can only see rows for the tenant set in the
// transaction-local setting `app.tenant_id`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  READ_ONLY
  SUSPENDED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum StaffRole {
  OWNER
  MANAGER
  FRONT_DESK
  HOUSEKEEPING
  ACCOUNTANT
  SUPERVISOR
  MAINTENANCE
  /// M5: waiter / cashier (POS) and kitchen / bar (KDS).
  WAITER
  KITCHEN
  /// The user holds a custom role (users.custom_role_id).
  CUSTOM
}

enum RoomStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED
  RESERVED
  OUT_OF_ORDER
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  city      String
  state     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  properties       Property[]
  roomTypes        RoomType[]
  rooms            Room[]
  users            User[]
  refreshTokens    RefreshToken[]
  featureOverrides TenantFeatureOverride[]
  subscription     Subscription?
  invoices         Invoice[]
  auditLogs        AuditLog[]

  guests            Guest[]
  reservations      Reservation[]
  folios            Folio[]
  folioEntries      FolioEntry[]
  guestInvoices     GuestInvoice[]
  receipts          Receipt[]
  documentCounters  DocumentCounter[]
  taxSettings       TaxSetting[]
  digestSettings    DigestSetting[]
  cashierShifts     CashierShift[]
  guardFlags        GuardFlag[]
  ownerDigests      OwnerDigest[]
  nightAuditRuns    NightAuditRun[]
  dailyStats        DailyStat[]
  housekeepingTasks HousekeepingTask[]
  idempotencyKeys   IdempotencyKey[]

  bookingPayments   BookingPayment[]
  bookingRefunds    BookingRefund[]
  commissionEntries CommissionEntry[]
  payoutAccounts    PayoutAccount[]
  reviews           Review[]
  notificationLogs  NotificationLog[]

  customRoles            CustomRole[]
  housekeepingChecklists HousekeepingChecklist[]
  lostFoundItems         LostFoundItem[]
  maintenanceTickets     MaintenanceTicket[]
  maintenanceEvents      MaintenanceTicketEvent[]
  roomBlocks             RoomBlock[]
  maintenanceSchedules   MaintenanceSchedule[]
  fuelLogs               FuelLog[]
  ratePlans              RatePlan[]
  rateRules              RateRule[]
  rateOverrides          RateOverride[]
  rateRestrictions       RateRestriction[]
  promoCodes             PromoCode[]
  promoRedemptions       PromoRedemption[]
  corporateAccounts      CorporateAccount[]
  cityLedgerCharges      CityLedgerCharge[]
  cityLedgerInvoices     CityLedgerInvoice[]
  cityLedgerPayments     CityLedgerPayment[]
  cityLedgerAllocations  CityLedgerAllocation[]
  notificationSettings   NotificationSetting[]
  guardAlerts            GuardAlert[]
  userPropertyAccess     UserPropertyAccess[]

  @@map("tenants")
}

model Property {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  name                   String
  slug                   String    @unique
  tagline                String    @default("")
  description            String    @default("")
  address                String    @default("")
  city                   String
  state                  String
  area                   String    @default("")
  phone                  String    @default("")
  email                  String    @default("")
  checkInTime            String    @default("14:00") @map("check_in_time")
  checkOutTime           String    @default("12:00") @map("check_out_time")
  coverImageUrl          String?   @map("cover_image_url")
  /// Array of `{ url, alt }`.
  images                 Json      @default("[]")
  amenities              String[]  @default([])
  policies               String[]  @default([])
  accentColor            String?   @map("accent_color")
  logoUrl                String?   @map("logo_url")
  listedOnMarketplace    Boolean   @default(true) @map("listed_on_marketplace")
  featured               Boolean   @default(false)
  rating                 Float?
  reviewCount            Int       @default(0) @map("review_count")
  customDomain           String?   @unique @map("custom_domain")
  customDomainVerifiedAt DateTime? @map("custom_domain_verified_at") @db.Timestamptz(3)

  // M3: online booking settings and cancellation policy.
  onlineBookingEnabled     Boolean @default(true) @map("online_booking_enabled")
  allowPayAtHotel          Boolean @default(true) @map("allow_pay_at_hotel")
  requireCardForPayAtHotel Boolean @default(false) @map("require_card_for_pay_at_hotel")
  freeCancellationHours    Int     @default(48) @map("free_cancellation_hours")
  lateCancellationFeePct   Int     @default(100) @map("late_cancellation_fee_pct")
  noShowFeePct             Int     @default(100) @map("no_show_fee_pct")
  preArrivalMessage        String  @default("") @map("pre_arrival_message")
  /// True once a Paystack subaccount exists (online payments possible).
  payoutReady              Boolean @default(false) @map("payout_ready")
  // M3: review aggregates (maintained on every review change).
  ratingCleanliness        Float?  @map("rating_cleanliness")
  ratingService            Float?  @map("rating_service")
  ratingLocation           Float?  @map("rating_location")
  ratingValue              Float?  @map("rating_value")
  /// { "1": n, ..., "5": n, "byTravellerType": { ... } }
  ratingDistribution       Json    @default("{}") @map("rating_distribution")
  // M4: housekeeping settings.
  requireInspection        Boolean @default(false) @map("require_inspection")
  stayoverEnabled          Boolean @default(true) @map("stayover_enabled")
  // M5: numbering prefix of invoices / receipts ("PWH"); null = M2 format (primary properties created before M5).
  invoicePrefix            String? @map("invoice_prefix")
  /// M5: void of a sent POS item at or above this value needs a second key.
  posVoidApprovalKobo      Int     @default(1000000) @map("pos_void_approval_kobo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomTypes              RoomType[]
  rooms                  Room[]
  reservations           Reservation[]
  folios                 Folio[]
  taxSetting             TaxSetting?
  digestSetting          DigestSetting?
  reviews                Review[]
  folioEntries           FolioEntry[]
  guestInvoices          GuestInvoice[]
  receipts               Receipt[]
  cashierShifts          CashierShift[]
  guardFlags             GuardFlag[]
  ownerDigests           OwnerDigest[]
  nightAuditRuns         NightAuditRun[]
  dailyStats             DailyStat[]
  housekeepingTasks      HousekeepingTask[]
  housekeepingChecklists HousekeepingChecklist[]
  lostFoundItems         LostFoundItem[]
  maintenanceTickets     MaintenanceTicket[]
  roomBlocks             RoomBlock[]
  maintenanceSchedules   MaintenanceSchedule[]
  fuelLogs               FuelLog[]
  rateOverrides          RateOverride[]
  rateRestrictions       RateRestriction[]
  payoutAccounts         PayoutAccount[]
  bookingPayments        BookingPayment[]
  commissionEntries      CommissionEntry[]
  ratePlans              RatePlan[]
  rateRules              RateRule[]
  notificationSettings   NotificationSetting[]

  userAccess UserPropertyAccess[]

  @@unique([tenantId, invoicePrefix])
  @@index([tenantId])
  @@index([city])
  @@map("properties")
}

model RoomType {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  propertyId          String   @map("property_id") @db.Uuid
  name                String
  description         String   @default("")
  basePriceKobo       Int      @map("base_price_kobo")
  hourlyPriceKobo     Int?     @map("hourly_price_kobo")
  capacity            Int      @default(2)
  bedType             String   @default("Queen") @map("bed_type")
  sizeSqm             Int      @default(20) @map("size_sqm")
  amenities           String[] @default([])
  /// Array of `{ url, alt }`.
  images              Json     @default("[]")
  sortOrder           Int      @default(0) @map("sort_order")
  /// M4: every N check-outs of a room of this type, the cleaning is a deep clean.
  deepCleanEveryStays Int?     @map("deep_clean_every_stays")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms         Room[]
  reservations  Reservation[]
  rateOverrides RateOverride[]

  @@unique([propertyId, name])
  @@index([tenantId])
  @@map("room_types")
}

model Room {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  propertyId          String     @map("property_id") @db.Uuid
  roomTypeId          String     @map("room_type_id") @db.Uuid
  number              String
  floor               Int
  status              RoomStatus @default(VACANT_CLEAN)
  notes               String?
  /// M4: check-outs since the last deep clean.
  staysSinceDeepClean Int        @default(0) @map("stays_since_deep_clean")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property          Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType          RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservations      Reservation[]
  housekeepingTasks HousekeepingTask[]
  guardFlags        GuardFlag[]
  roomBlocks        RoomBlock[]
  tickets           MaintenanceTicket[]
  lostFound         LostFoundItem[]

  @@unique([propertyId, number])
  @@index([tenantId, status])
  @@index([roomTypeId])
  @@map("rooms")
}

// ---------------------------------------------------------------------------
// Hotel staff + sessions
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  email             String    @unique
  fullName          String    @map("full_name")
  phone             String    @default("")
  role              StaffRole
  /// Set when role = CUSTOM.
  customRoleId      String?   @map("custom_role_id") @db.Uuid
  passwordHash      String    @map("password_hash")
  isActive          Boolean   @default(true) @map("is_active")
  /// M5: access to every property of the group (else the user_property_access rows).
  allProperties     Boolean   @default(true) @map("all_properties")
  /// M5: property used when a request carries no X-Property-Id.
  defaultPropertyId String?   @map("default_property_id") @db.Uuid
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// argon2 hash of the optional 4-6 digit second-key approval PIN.
  approvalPinHash   String?   @map("approval_pin_hash")
  pinFailedCount    Int       @default(0) @map("pin_failed_count")
  pinLockedUntil    DateTime? @map("pin_locked_until") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customRole     CustomRole?          @relation(fields: [customRoleId], references: [id], onDelete: Restrict)
  refreshTokens  RefreshToken[]
  propertyAccess UserPropertyAccess[]

  @@index([tenantId])
  @@index([customRoleId])
  @@map("users")
}

/// Opaque rotating refresh tokens. Only an HMAC of the secret is stored.
/// Tokens issued from one login share a `familyId`; presenting a token that
/// was already rotated revokes the whole family (reuse detection).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Platform (Devstrike staff)
// ---------------------------------------------------------------------------

model PlatformUser {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  fullName     String       @map("full_name")
  passwordHash String       @map("password_hash")
  role         PlatformRole @default(SUPER_ADMIN)
  isActive     Boolean      @default(true) @map("is_active")
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_users")
}

// ---------------------------------------------------------------------------
// Plans, features, entitlements
// ---------------------------------------------------------------------------

model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  tagline          String   @default("")
  priceMonthlyKobo Int?     @map("price_monthly_kobo")
  priceYearlyKobo  Int?     @map("price_yearly_kobo")
  /// Record<limitCode, number>; -1 means unlimited.
  limits           Json     @default("{}")
  commissionBps    Int?     @map("commission_bps")
  highlighted      Boolean  @default(false)
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

model Feature {
  code        String @id
  name        String
  description String @default("")
  category    String

  plans     PlanFeature[]
  overrides TenantFeatureOverride[]

  @@map("features")
}

model PlanFeature {
  planId      String @map("plan_id") @db.Uuid
  featureCode String @map("feature_code")

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureCode], references: [code], onDelete: Cascade)

  @@id([planId, featureCode])
  @@map("plan_features")
}

/// Per-tenant add-ons (enabled = true) or removals (enabled = false).
model TenantFeatureOverride {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  featureCode String   @map("feature_code")
  enabled     Boolean
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureCode], references: [code], onDelete: Cascade)

  @@unique([tenantId, featureCode])
  @@map("tenant_feature_overrides")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Subscription {
  id                       String             @id @default(uuid()) @db.Uuid
  tenantId                 String             @unique @map("tenant_id") @db.Uuid
  planId                   String             @map("plan_id") @db.Uuid
  status                   SubscriptionStatus
  interval                 BillingInterval    @default(MONTHLY)
  trialEndsAt              DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart       DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd         DateTime?          @map("current_period_end") @db.Timestamptz(3)
  pastDueAt                DateTime?          @map("past_due_at") @db.Timestamptz(3)
  readOnlyAt               DateTime?          @map("read_only_at") @db.Timestamptz(3)
  suspendedAt              DateTime?          @map("suspended_at") @db.Timestamptz(3)
  cancelledAt              DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  paystackCustomerCode     String?            @map("paystack_customer_code")
  paystackSubscriptionCode String?            @map("paystack_subscription_code")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  subscriptionId   String          @map("subscription_id") @db.Uuid
  reference        String          @unique
  amountKobo       Int             @map("amount_kobo")
  currency         String          @default("NGN")
  status           InvoiceStatus   @default(PENDING)
  planCode         String          @map("plan_code")
  interval         BillingInterval
  provider         String          @default("paystack")
  authorizationUrl String?         @map("authorization_url")
  paidAt           DateTime?       @map("paid_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("invoices")
}

/// Webhook idempotency ledger. `eventKey` is derived from the provider event
/// and is unique, so a replayed webhook is detected and acknowledged without
/// being processed twice.
model PaymentEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @default("paystack")
  eventKey    String    @unique @map("event_key")
  eventType   String    @map("event_type")
  tenantId    String?   @map("tenant_id") @db.Uuid
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// Audit (append-only, enforced by a database trigger)
// ---------------------------------------------------------------------------

model AuditLog {
  id                  String   @id @default(uuid()) @db.Uuid
  /// Null for platform-level events (plan edits, console logins). Such rows
  /// match no tenant policy and are visible only in the system context.
  tenantId            String?  @map("tenant_id") @db.Uuid
  /// Staff actor. Deliberately not a foreign key: staff can be deleted while
  /// their audit history (which may never be updated) is retained.
  actorUserId         String?  @map("actor_user_id") @db.Uuid
  actorPlatformUserId String?  @map("actor_platform_user_id") @db.Uuid
  /// Snapshot of the actor's name at the time of the action.
  actorName           String?  @map("actor_name")
  /// M5: property the action happened in (null = group-wide or before M5). No FK (append-only).
  propertyId          String?  @map("property_id") @db.Uuid
  action              String
  entityType          String   @map("entity_type")
  entityId            String?  @map("entity_id")
  metadata            Json     @default("{}")
  ip                  String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ===========================================================================
// M2: core hotel operations
// ===========================================================================
//
// Money columns are BIGINT kobo. Business dates are DATE in Africa/Lagos.
// Every table below is tenant-scoped and protected by RLS (see the
// *_m2_operations migration), which also adds what Prisma cannot model:
// the reservation exclusion constraint, the append-only folio_entries
// trigger and a few partial unique indexes.

enum StayType {
  NIGHTLY
  DAY_USE
}

enum ReservationSource {
  WALK_IN
  PHONE
  WHATSAPP
  MARKETPLACE
  BOOKING_SITE
  CORPORATE
  OTA
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum IdType {
  NIN
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
  OTHER
}

enum Gender {
  MALE
  FEMALE
  UNDISCLOSED
}

enum VisitPurpose {
  BUSINESS
  LEISURE
  EVENT
  TRANSIT
  OTHER
}

enum FolioKind {
  RESERVATION
  WALK_IN
  POS
}

enum FolioStatus {
  OPEN
  CLOSED
}

enum FolioEntryType {
  ROOM
  DAY_USE
  EXTRA
  TAX
  SERVICE_CHARGE
  DISCOUNT
  PAYMENT
  REFUND
  VOID
}

enum TaxCode {
  VAT
  CONSUMPTION
  SERVICE_CHARGE
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
  CARD_ONLINE
  COMPLIMENTARY
  CITY_LEDGER
}

enum GuestInvoiceKind {
  PROFORMA
  FINAL
}

enum DocumentCounterKind {
  INVOICE
  PROFORMA
  RECEIPT
  MAINTENANCE_TICKET
  CITY_LEDGER
  POS_ORDER
  KDS_TICKET
  LOYALTY_MEMBER
}

enum ShiftStatus {
  OPEN
  CLOSED
  APPROVED
}

enum GuardRule {
  SHIFT_VARIANCE
  VOIDED_PAYMENT
  CHECKOUT_WITH_BALANCE
  OCCUPIED_WITHOUT_STAY
  DISCOUNT_OVER_THRESHOLD
  DIRTY_OVERRIDE_CHECKIN
  DAY_USE_OVERSTAY
  LATE_REGISTRATION
  REPEATED_VOIDS_BY_USER
  ROOM_STATUS_FLIP
  PAYMENT_ORPHANED
  POS_VOID_AFTER_SEND
  ROOM_CHARGE_NO_GUEST
  STOCK_VARIANCE
  POS_OPEN_TABS_AT_SHIFT_CLOSE
  OVERBOOKED
  LOYALTY_ADJUSTMENT
}

enum GuardSeverity {
  LOW
  MEDIUM
  HIGH
}

enum GuardStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum HousekeepingTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  ASSIGNED
  INSPECTED
  REJECTED
  SKIPPED
}

/// Where a task came from (API field `source`).
enum HousekeepingTaskReason {
  CHECKOUT
  ROOM_MOVE
  MANUAL
  STAYOVER_JOB
  DEEP_CLEAN_RULE
  MAINTENANCE
}

enum HousekeepingTaskType {
  CHECKOUT_CLEAN
  STAYOVER
  DEEP_CLEAN
  TURNDOWN
  INSPECTION
  CUSTOM
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DigestChannel {
  WHATSAPP
  LOG
}

enum DigestStatus {
  SENT
  LOGGED
  FAILED
}

enum NightAuditStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum JobTrigger {
  SCHEDULED
  MANUAL
}

/// Hotel guest. `idNumberEnc` is AES-256-GCM ciphertext (GUEST_DATA_KEY);
/// only the last four digits are kept in clear for masking. Deduplicated by
/// phone per tenant (NULL after NDPA anonymisation).
model Guest {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  fullName           String    @map("full_name")
  phone              String?
  email              String?
  gender             Gender?
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  nationality        String    @default("Nigerian")
  address            String?
  idType             IdType?   @map("id_type")
  idNumberEnc        String?   @map("id_number_enc")
  idNumberLast4      String?   @map("id_number_last4")
  idImageKey         String?   @map("id_image_key")
  idImageContentType String?   @map("id_image_content_type")
  vehiclePlate       String?   @map("vehicle_plate")
  company            String?
  vip                Boolean   @default(false)
  notes              String    @default("")
  consentAt          DateTime? @map("consent_at") @db.Timestamptz(3)
  marketingOptIn     Boolean   @default(false) @map("marketing_opt_in")
  anonymisedAt       DateTime? @map("anonymised_at") @db.Timestamptz(3)
  /// Platform-level guest account (guest_accounts.id) linked by verified phone. No FK: that table is platform-only.
  guestAccountId     String?   @map("guest_account_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  folios       Folio[]
  reviews      Review[]

  @@unique([tenantId, phone])
  @@index([guestAccountId])
  @@index([tenantId, fullName])
  @@map("guests")
}

/// A stay. Overlap on the same room is prevented by the exclusion constraint
/// `reservations_no_overlap` (btree_gist) for PENDING, CONFIRMED, CHECKED_IN.
model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  propertyId      String            @map("property_id") @db.Uuid
  code            String
  guestId         String            @map("guest_id") @db.Uuid
  roomTypeId      String            @map("room_type_id") @db.Uuid
  roomId          String?           @map("room_id") @db.Uuid
  stayType        StayType          @default(NIGHTLY) @map("stay_type")
  arrivalAt       DateTime          @map("arrival_at") @db.Timestamptz(3)
  departureAt     DateTime          @map("departure_at") @db.Timestamptz(3)
  adults          Int               @default(1)
  children        Int               @default(0)
  source          ReservationSource @default(WALK_IN)
  status          ReservationStatus @default(CONFIRMED)
  rateKobo        BigInt            @map("rate_kobo")
  notes           String            @default("")
  createdById     String?           @map("created_by_id") @db.Uuid
  checkedInAt     DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  checkedInById   String?           @map("checked_in_by_id") @db.Uuid
  checkedOutAt    DateTime?         @map("checked_out_at") @db.Timestamptz(3)
  checkedOutById  String?           @map("checked_out_by_id") @db.Uuid
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?           @map("cancel_reason")
  noShowAt        DateTime?         @map("no_show_at") @db.Timestamptz(3)
  clientCreatedAt DateTime?         @map("client_created_at") @db.Timestamptz(3)

  // Guest register entry (police / security book).
  regArrivingFrom           String?       @map("reg_arriving_from")
  regGoingTo                String?       @map("reg_going_to")
  regPurpose                VisitPurpose? @map("reg_purpose")
  regVehiclePlate           String?       @map("reg_vehicle_plate")
  registrationCompletedAt   DateTime?     @map("registration_completed_at") @db.Timestamptz(3)
  registrationCompletedById String?       @map("registration_completed_by_id") @db.Uuid

  // M3: online bookings (null for desk bookings).
  paymentMode         PaymentMode?   @map("payment_mode")
  guaranteeType       GuaranteeType? @map("guarantee_type")
  holdExpiresAt       DateTime?      @map("hold_expires_at") @db.Timestamptz(3)
  commissionBps       Int?           @map("commission_bps")
  quotedTotalKobo     BigInt?        @map("quoted_total_kobo")
  /// Nonce of the quote token the booking was made from (idempotent retries).
  quoteRef            String?        @map("quote_ref")
  /// PriceBreakdown snapshot the guest accepted.
  quote               Json?
  contactPhone        String?        @map("contact_phone")
  contactEmail        String?        @map("contact_email")
  specialRequests     String         @default("") @map("special_requests")
  guestAccountId      String?        @map("guest_account_id") @db.Uuid
  cancelledBy         CancelledBy?   @map("cancelled_by")
  cancellationFeeKobo BigInt?        @map("cancellation_fee_kobo")

  // M4: rates, promotions, corporate.
  ratePlanId         String? @map("rate_plan_id") @db.Uuid
  promoCodeId        String? @map("promo_code_id") @db.Uuid
  corporateAccountId String? @map("corporate_account_id") @db.Uuid
  /// Per-night price snapshot: { date, rateKobo, baseRateKobo, source, ruleId, ruleName, discountKobo }[].
  nightlyRates       Json    @default("[]") @map("nightly_rates")
  /// Cancellation policy of the rate plan at booking (null = hotel policy).
  cancelPolicy       Json?   @map("cancel_policy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest             Guest              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room              Room?              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  folio             Folio?
  housekeepingTasks HousekeepingTask[]
  guardFlags        GuardFlag[]
  bookingPayments   BookingPayment[]
  bookingRefunds    BookingRefund[]
  commissionEntries CommissionEntry[]
  review            Review?
  notificationLogs  NotificationLog[]
  ratePlan          RatePlan?          @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)
  promoCode         PromoCode?         @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  corporateAccount  CorporateAccount?  @relation(fields: [corporateAccountId], references: [id], onDelete: Restrict)
  promoRedemption   PromoRedemption?
  cityLedgerCharges CityLedgerCharge[]

  @@unique([tenantId, code])
  @@unique([tenantId, quoteRef])
  @@index([guestAccountId])
  @@index([status, holdExpiresAt])
  @@index([tenantId, status])
  @@index([tenantId, arrivalAt])
  @@index([tenantId, departureAt])
  @@index([guestId])
  @@index([roomTypeId])
  @@index([roomId])
  @@index([propertyId, arrivalAt])
  @@map("reservations")
}

model Folio {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  propertyId    String      @map("property_id") @db.Uuid
  kind          FolioKind   @default(RESERVATION)
  status        FolioStatus @default(OPEN)
  reservationId String?     @unique @map("reservation_id") @db.Uuid
  guestId       String?     @map("guest_id") @db.Uuid
  name          String
  notes         String      @default("")
  createdById   String?     @map("created_by_id") @db.Uuid
  closedAt      DateTime?   @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation?   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guest       Guest?         @relation(fields: [guestId], references: [id], onDelete: Restrict)
  entries     FolioEntry[]
  invoices    GuestInvoice[]
  receipts    Receipt[]

  @@index([tenantId, status])
  @@index([propertyId, status])
  @@map("folios")
}

/// Immutable ledger line (trigger blocks UPDATE/DELETE). Corrections are VOID
/// entries; `refEntryId` is unique, so an entry can be voided only once.
model FolioEntry {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  propertyId      String         @map("property_id") @db.Uuid
  folioId         String         @map("folio_id") @db.Uuid
  type            FolioEntryType
  amountKobo      BigInt         @map("amount_kobo")
  description     String
  businessDate    DateTime       @map("business_date") @db.Date
  parentEntryId   String?        @map("parent_entry_id") @db.Uuid
  refEntryId      String?        @unique @map("ref_entry_id") @db.Uuid
  taxCode         TaxCode?       @map("tax_code")
  rateBps         Int?           @map("rate_bps")
  inclusive       Boolean?
  paymentMethod   PaymentMethod? @map("payment_method")
  paymentRef      String?        @map("payment_ref")
  shiftId         String?        @map("shift_id") @db.Uuid
  reason          String?
  approvedById    String?        @map("approved_by_id") @db.Uuid
  createdById     String?        @map("created_by_id") @db.Uuid
  clientCreatedAt DateTime?      @map("client_created_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  folio    Folio         @relation(fields: [folioId], references: [id], onDelete: Restrict)
  shift    CashierShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  receipt  Receipt?

  @@index([folioId, createdAt])
  @@index([tenantId, businessDate])
  @@index([tenantId, type, createdAt])
  @@index([shiftId])
  @@index([parentEntryId])
  @@index([propertyId, businessDate])
  @@map("folio_entries")
}

/// Gapless per-tenant, per-year document numbers. Incremented with
/// `INSERT .. ON CONFLICT DO UPDATE .. RETURNING` inside the issuing
/// transaction: the row lock serialises issuers and a rollback returns the
/// number, so there are no gaps.
model DocumentCounter {
  tenantId  String              @map("tenant_id") @db.Uuid
  kind      DocumentCounterKind
  year      Int
  /// '' for group-wide series; the property id for per-property series (invoices, receipts, POS).
  scope     String              @default("")
  lastValue Int                 @default(0) @map("last_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, kind, year, scope])
  @@map("document_counters")
}

model GuestInvoice {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  propertyId      String           @map("property_id") @db.Uuid
  folioId         String           @map("folio_id") @db.Uuid
  kind            GuestInvoiceKind
  number          String
  year            Int
  seq             Int
  issuedAt        DateTime         @default(now()) @map("issued_at") @db.Timestamptz(3)
  businessDate    DateTime         @map("business_date") @db.Date
  totalKobo       BigInt           @map("total_kobo")
  balanceKobo     BigInt           @map("balance_kobo")
  guestName       String?          @map("guest_name")
  reservationCode String?          @map("reservation_code")
  /// Snapshot of the printable document at issue time.
  document        Json
  issuedById      String?          @map("issued_by_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  folio    Folio    @relation(fields: [folioId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@index([tenantId, issuedAt])
  @@index([folioId])
  @@map("guest_invoices")
}

model Receipt {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  propertyId      String        @map("property_id") @db.Uuid
  folioId         String        @map("folio_id") @db.Uuid
  entryId         String        @unique @map("entry_id") @db.Uuid
  number          String
  year            Int
  seq             Int
  issuedAt        DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  method          PaymentMethod
  amountKobo      BigInt        @map("amount_kobo")
  guestName       String?       @map("guest_name")
  reservationCode String?       @map("reservation_code")
  document        Json
  issuedById      String?       @map("issued_by_id") @db.Uuid

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  folio    Folio      @relation(fields: [folioId], references: [id], onDelete: Restrict)
  entry    FolioEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@index([tenantId, issuedAt])
  @@map("receipts")
}

model TaxSetting {
  id                           String   @id @default(uuid()) @db.Uuid
  tenantId                     String   @map("tenant_id") @db.Uuid
  propertyId                   String   @unique @map("property_id") @db.Uuid
  vatEnabled                   Boolean  @default(true) @map("vat_enabled")
  vatRateBps                   Int      @default(750) @map("vat_rate_bps")
  vatInclusive                 Boolean  @default(false) @map("vat_inclusive")
  consumptionEnabled           Boolean  @default(false) @map("consumption_enabled")
  consumptionRateBps           Int      @default(500) @map("consumption_rate_bps")
  consumptionInclusive         Boolean  @default(false) @map("consumption_inclusive")
  consumptionLabel             String   @default("Lagos consumption tax") @map("consumption_label")
  serviceChargeEnabled         Boolean  @default(false) @map("service_charge_enabled")
  serviceChargeRateBps         Int      @default(1000) @map("service_charge_rate_bps")
  serviceChargeInclusive       Boolean  @default(false) @map("service_charge_inclusive")
  discountApprovalThresholdBps Int      @default(1000) @map("discount_approval_threshold_bps")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tax_settings")
}

model DigestSetting {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  propertyId String   @unique @map("property_id") @db.Uuid
  enabled    Boolean  @default(true)
  recipients String[] @default([])
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("digest_settings")
}

/// Cashier shift. One OPEN shift per user (partial unique index).
model CashierShift {
  id                   String      @id @default(uuid()) @db.Uuid
  tenantId             String      @map("tenant_id") @db.Uuid
  propertyId           String      @map("property_id") @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  userName             String      @map("user_name")
  status               ShiftStatus @default(OPEN)
  openedAt             DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  openingFloatKobo     BigInt      @map("opening_float_kobo")
  closedAt             DateTime?   @map("closed_at") @db.Timestamptz(3)
  closedById           String?     @map("closed_by_id") @db.Uuid
  countedCashKobo      BigInt?     @map("counted_cash_kobo")
  declaredPosKobo      BigInt?     @map("declared_pos_kobo")
  declaredTransferKobo BigInt?     @map("declared_transfer_kobo")
  denominations        Json?
  expectedCashKobo     BigInt?     @map("expected_cash_kobo")
  expectedPosKobo      BigInt?     @map("expected_pos_kobo")
  expectedTransferKobo BigInt?     @map("expected_transfer_kobo")
  paymentsCount        Int?        @map("payments_count")
  notes                String      @default("")
  closeNotes           String?     @map("close_notes")
  approvedById         String?     @map("approved_by_id") @db.Uuid
  approvedByName       String?     @map("approved_by_name")
  approvedAt           DateTime?   @map("approved_at") @db.Timestamptz(3)
  approvalNotes        String?     @map("approval_notes")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  entries  FolioEntry[]

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@index([userId])
  @@index([propertyId, status])
  @@map("cashier_shifts")
}

/// Revenue Guard finding. `dedupeKey` is unique per tenant while the flag is
/// OPEN or ACKNOWLEDGED (partial unique index), so sweeps never duplicate.
model GuardFlag {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  propertyId     String        @map("property_id") @db.Uuid
  rule           GuardRule
  severity       GuardSeverity
  status         GuardStatus   @default(OPEN)
  title          String
  detail         String        @default("")
  amountKobo     BigInt?       @map("amount_kobo")
  roomId         String?       @map("room_id") @db.Uuid
  reservationId  String?       @map("reservation_id") @db.Uuid
  shiftId        String?       @map("shift_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  userName       String?       @map("user_name")
  evidence       Json          @default("{}")
  suggestion     String?
  dedupeKey      String        @map("dedupe_key")
  resolvedById   String?       @map("resolved_by_id") @db.Uuid
  resolvedByName String?       @map("resolved_by_name")
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(3)
  resolution     String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, rule])
  @@index([propertyId, status])
  @@map("guard_flags")
}

model OwnerDigest {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  propertyId   String        @map("property_id") @db.Uuid
  businessDate DateTime      @map("business_date") @db.Date
  trigger      JobTrigger    @default(SCHEDULED)
  channel      DigestChannel
  status       DigestStatus
  recipients   String[]      @default([])
  body         String
  data         Json
  error        String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, businessDate])
  @@map("owner_digests")
}

model NightAuditRun {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  propertyId   String           @map("property_id") @db.Uuid
  businessDate DateTime         @map("business_date") @db.Date
  status       NightAuditStatus @default(RUNNING)
  trigger      JobTrigger       @default(SCHEDULED)
  startedAt    DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?        @map("finished_at") @db.Timestamptz(3)
  summary      Json?
  error        String?
  runById      String?          @map("run_by_id") @db.Uuid
  runByName    String?          @map("run_by_name")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, businessDate])
  @@index([tenantId, businessDate])
  @@map("night_audit_runs")
}

/// Snapshot of the daily flash report, written by the night audit.
model DailyStat {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  propertyId        String   @map("property_id") @db.Uuid
  date              DateTime @db.Date
  roomsAvailable    Int      @map("rooms_available")
  roomsSold         Int      @map("rooms_sold")
  occupancyRate     Float    @map("occupancy_rate")
  adrKobo           BigInt   @map("adr_kobo")
  revparKobo        BigInt   @map("revpar_kobo")
  roomRevenueKobo   BigInt   @map("room_revenue_kobo")
  totalRevenueKobo  BigInt   @map("total_revenue_kobo")
  paymentsTotalKobo BigInt   @map("payments_total_kobo")
  dayUseCount       Int      @map("day_use_count")
  /// Full DailyFlash payload (see API contract).
  data              Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@index([tenantId, date])
  @@map("daily_stats")
}

model HousekeepingTask {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  propertyId      String                 @map("property_id") @db.Uuid
  roomId          String                 @map("room_id") @db.Uuid
  reservationId   String?                @map("reservation_id") @db.Uuid
  status          HousekeepingTaskStatus @default(OPEN)
  reason          HousekeepingTaskReason @default(CHECKOUT)
  type            HousekeepingTaskType   @default(CHECKOUT_CLEAN)
  priority        TaskPriority           @default(NORMAL)
  /// Lagos date the task belongs to.
  businessDate    DateTime               @default(dbgenerated("(now() AT TIME ZONE 'Africa/Lagos')::date")) @map("business_date") @db.Date
  assigneeId      String?                @map("assignee_id") @db.Uuid
  assigneeName    String?                @map("assignee_name")
  dueAt           DateTime?              @map("due_at") @db.Timestamptz(3)
  startedAt       DateTime?              @map("started_at") @db.Timestamptz(3)
  /// Snapshot of the checklist: { id, label, done }[].
  checklist       Json                   @default("[]")
  /// { key, uploadedAt }[] (object storage keys).
  photos          Json                   @default("[]")
  inspectedAt     DateTime?              @map("inspected_at") @db.Timestamptz(3)
  inspectedById   String?                @map("inspected_by_id") @db.Uuid
  inspectedByName String?                @map("inspected_by_name")
  inspectionNote  String?                @map("inspection_note")
  skippedReason   String?                @map("skipped_reason")
  clientCreatedAt DateTime?              @map("client_created_at") @db.Timestamptz(3)
  notes           String                 @default("")
  completedAt     DateTime?              @map("completed_at") @db.Timestamptz(3)
  completedById   String?                @map("completed_by_id") @db.Uuid
  completedByName String?                @map("completed_by_name")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room        Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservation Reservation?        @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  tickets     MaintenanceTicket[]

  @@index([tenantId, status])
  @@index([tenantId, businessDate])
  @@index([assigneeId])
  @@index([propertyId, businessDate])
  @@map("housekeeping_tasks")
}

/// Stored responses for the Idempotency-Key header (72h).
model IdempotencyKey {
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  fingerprint    String
  completed      Boolean  @default(false)
  /// Set inside the request's business transaction(s) that wrote data, so it
  /// commits or rolls back with them: an applied key is never executed again.
  applied        Boolean  @default(false)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ===========================================================================
// M3: online booking, payments, commission, guests, reviews, notifications
// ===========================================================================

enum PaymentMode {
  ONLINE
  PAY_AT_HOTEL
}

enum GuaranteeType {
  NONE
  PREPAID
}

enum CancelledBy {
  GUEST
  HOTEL
  SYSTEM
}

enum BookingPaymentStatus {
  INITIALIZED
  SUCCEEDED
  FAILED
  ORPHANED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrphanReason {
  LATE_NO_INVENTORY
  AMOUNT_MISMATCH
  BOOKING_CANCELLED
  DUPLICATE_PAYMENT
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RefundReason {
  GUEST_CANCELLED
  HOTEL_CANCELLED
  PAYMENT_ORPHANED
}

enum CommissionKind {
  ACCRUED
  COLLECTED
  REVERSED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum TravellerType {
  BUSINESS
  COUPLE
  FAMILY
  SOLO
  FRIENDS
}

enum ModerationReason {
  ABUSE
  PII
  SPAM
  OFF_TOPIC
  OTHER
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  OUTBOX
}

enum NotificationAudience {
  GUEST
  HOTEL
  PLATFORM
}

enum GuestChallengeKind {
  OTP
  MAGIC_LINK
}

/// One Paystack transaction attempt for an online booking. `reference` is
/// globally unique; the webhook finds the booking through it.
model BookingPayment {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  propertyId            String               @map("property_id") @db.Uuid
  reservationId         String               @map("reservation_id") @db.Uuid
  reference             String               @unique
  provider              String               @default("paystack")
  status                BookingPaymentStatus @default(INITIALIZED)
  amountKobo            BigInt               @map("amount_kobo")
  commissionKobo        BigInt               @map("commission_kobo")
  commissionBps         Int                  @map("commission_bps")
  currency              String               @default("NGN")
  subaccountCode        String?              @map("subaccount_code")
  authorizationUrl      String?              @map("authorization_url")
  accessCode            String?              @map("access_code")
  callbackUrl           String               @map("callback_url")
  email                 String
  paidAmountKobo        BigInt?              @map("paid_amount_kobo")
  paidAt                DateTime?            @map("paid_at") @db.Timestamptz(3)
  channel               String?
  providerTransactionId String?              @map("provider_transaction_id")
  orphanReason          OrphanReason?        @map("orphan_reason")
  folioEntryId          String?              @map("folio_entry_id") @db.Uuid
  lastVerifiedAt        DateTime?            @map("last_verified_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  refunds     BookingRefund[]
  commission  CommissionEntry[]

  @@index([tenantId, createdAt])
  @@index([reservationId])
  @@index([status])
  @@map("booking_payments")
}

model BookingRefund {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  reservationId    String       @map("reservation_id") @db.Uuid
  amountKobo       BigInt       @map("amount_kobo")
  reason           RefundReason
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @map("provider_refund_id")
  error            String?
  attempts         Int          @default(0)
  requestedBy      String?      @map("requested_by")
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment     BookingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reservation Reservation    @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([paymentId])
  @@index([status])
  @@map("booking_refunds")
}

/// Platform commission per online booking. Amounts are positive; the net
/// commission is COLLECTED + ACCRUED - REVERSED. `accrual` tells a REVERSED
/// entry which side it reduces.
model CommissionEntry {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  propertyId    String            @map("property_id") @db.Uuid
  reservationId String            @map("reservation_id") @db.Uuid
  paymentId     String?           @map("payment_id") @db.Uuid
  kind          CommissionKind
  /// For REVERSED: true when it reverses an ACCRUED (receivable) entry.
  accrual       Boolean           @default(false)
  amountKobo    BigInt            @map("amount_kobo")
  baseKobo      BigInt            @map("base_kobo")
  commissionBps Int               @map("commission_bps")
  channel       ReservationSource
  note          String?
  settledAt     DateTime?         @map("settled_at") @db.Timestamptz(3)
  settlementRef String?           @map("settlement_ref")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  payment     BookingPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([reservationId])
  @@map("commission_entries")
}

/// Hotel payout bank account and its Paystack subaccount.
model PayoutAccount {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  propertyId         String   @unique @map("property_id") @db.Uuid
  bankCode           String   @map("bank_code")
  bankName           String   @map("bank_name")
  /// AES-256-GCM ciphertext (GUEST_DATA_KEY), tenant id as associated data.
  accountNumberEnc   String   @map("account_number_enc")
  accountNumberLast4 String   @map("account_number_last4")
  accountName        String   @map("account_name")
  businessName       String   @map("business_name")
  subaccountCode     String   @map("subaccount_code")
  provider           String   @default("paystack")
  settlementVerified Boolean  @default(false) @map("settlement_verified")
  percentageCharge   Float    @default(0) @map("percentage_charge")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payout_accounts")
}

/// Verified-stay review: one per checked-out reservation.
model Review {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  propertyId       String            @map("property_id") @db.Uuid
  reservationId    String            @unique @map("reservation_id") @db.Uuid
  guestId          String            @map("guest_id") @db.Uuid
  guestAccountId   String?           @map("guest_account_id") @db.Uuid
  overall          Int
  cleanliness      Int
  service          Int
  location         Int
  value            Int
  title            String?
  body             String
  stayMonth        String            @map("stay_month")
  travellerType    TravellerType     @map("traveller_type")
  displayName      String            @map("display_name")
  status           ReviewStatus      @default(PUBLISHED)
  hotelReply       String?           @map("hotel_reply")
  hotelRepliedAt   DateTime?         @map("hotel_replied_at") @db.Timestamptz(3)
  hotelRepliedById String?           @map("hotel_replied_by_id") @db.Uuid
  flaggedReason    String?           @map("flagged_reason")
  flaggedAt        DateTime?         @map("flagged_at") @db.Timestamptz(3)
  hiddenReason     ModerationReason? @map("hidden_reason")
  moderationNote   String?           @map("moderation_note")
  moderatedAt      DateTime?         @map("moderated_at") @db.Timestamptz(3)
  moderatedBy      String?           @map("moderated_by")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guest       Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@index([propertyId, status, createdAt(sort: Desc)])
  @@index([tenantId, createdAt])
  @@index([status])
  @@map("reviews")
}

/// Every guest / hotel / platform message. Tenant-scoped when it concerns a
/// hotel (RLS); OTP and magic-link rows have no tenant and are visible to the
/// platform role only.
model NotificationLog {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String?              @map("tenant_id") @db.Uuid
  reservationId     String?              @map("reservation_id") @db.Uuid
  guestAccountId    String?              @map("guest_account_id") @db.Uuid
  template          String
  channel           NotificationChannel
  audience          NotificationAudience @default(GUEST)
  recipient         String
  subject           String?
  bodyText          String               @map("body_text")
  bodyHtml          String?              @map("body_html")
  status            NotificationStatus   @default(QUEUED)
  provider          String
  providerMessageId String?              @map("provider_message_id")
  attempts          Int                  @default(0)
  error             String?
  /// M4: approved WhatsApp template and parameters ({ name, language, params }) used outside the 24-hour window.
  waTemplate        Json?                @map("wa_template")
  /// e.g. "PRE_ARRIVAL:<reservationId>:EMAIL"; unique so scheduled messages go out once.
  dedupeKey         String?              @unique @map("dedupe_key")
  sentAt            DateTime?            @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([reservationId])
  @@index([status])
  @@map("notification_logs")
}

// ---------------------------------------------------------------------------
// Platform-level guest identity (hotel_platform only; no hotel_app grants)
// ---------------------------------------------------------------------------

model GuestAccount {
  id             String    @id @default(uuid()) @db.Uuid
  phone          String    @unique
  email          String?
  fullName       String    @default("") @map("full_name")
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens GuestRefreshToken[]

  @@index([email])
  @@map("guest_accounts")
}

/// OTP (6 digits) or magic-link challenge. Only an HMAC of the secret is stored.
model GuestOtpChallenge {
  id          String             @id @default(uuid()) @db.Uuid
  kind        GuestChallengeKind @default(OTP)
  phone       String?
  email       String?
  channel     String
  codeHash    String             @map("code_hash")
  attempts    Int                @default(0)
  maxAttempts Int                @default(5) @map("max_attempts")
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?          @map("consumed_at") @db.Timestamptz(3)
  lockedAt    DateTime?          @map("locked_at") @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([email, createdAt])
  @@map("guest_otp_challenges")
}

model GuestRefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  guestAccountId String    @map("guest_account_id") @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason   String?   @map("revoke_reason")
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account GuestAccount @relation(fields: [guestAccountId], references: [id], onDelete: Cascade)

  @@index([guestAccountId])
  @@index([familyId])
  @@map("guest_refresh_tokens")
}

// ===========================================================================
// M4: permissions, housekeeping, maintenance, rates, promotions, corporate,
// WhatsApp alerts. Every table is tenant-scoped with RLS (see the
// *_m4_growth migration) except the platform-level WhatsApp inbound log.
// ===========================================================================

/// Custom staff role (system roles live in code). `permissions` are catalogue codes.
model CustomRole {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String   @default("")
  permissions String[] @default([])
  basedOn     String?  @map("based_on")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@map("custom_roles")
}

/// Checklist template per room type (null = every type) and task type.
model HousekeepingChecklist {
  id         String               @id @default(uuid()) @db.Uuid
  tenantId   String               @map("tenant_id") @db.Uuid
  propertyId String               @map("property_id") @db.Uuid
  roomTypeId String?              @map("room_type_id") @db.Uuid
  taskType   HousekeepingTaskType @map("task_type")
  /// { id, label }[]
  items      Json                 @default("[]")
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("housekeeping_checklists")
}

enum LostFoundStatus {
  HELD
  RETURNED
  DISPOSED
}

model LostFoundItem {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  propertyId      String          @map("property_id") @db.Uuid
  description     String
  category        String          @default("Other")
  roomId          String?         @map("room_id") @db.Uuid
  location        String?
  foundById       String?         @map("found_by_id") @db.Uuid
  foundByName     String?         @map("found_by_name")
  foundAt         DateTime        @default(now()) @map("found_at") @db.Timestamptz(3)
  status          LostFoundStatus @default(HELD)
  storageLocation String?         @map("storage_location")
  guestId         String?         @map("guest_id") @db.Uuid
  reservationId   String?         @map("reservation_id") @db.Uuid
  returnedTo      String?         @map("returned_to")
  returnedAt      DateTime?       @map("returned_at") @db.Timestamptz(3)
  disposedAt      DateTime?       @map("disposed_at") @db.Timestamptz(3)
  notes           String          @default("")
  photos          Json            @default("[]")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, foundAt(sort: Desc)])
  @@map("lost_found_items")
}

enum MaintenanceCategory {
  ELECTRICAL
  PLUMBING
  AC_HVAC
  FURNITURE
  APPLIANCE
  GENERATOR
  CIVIL
  IT
  OTHER
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

model MaintenanceTicket {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  propertyId         String              @map("property_id") @db.Uuid
  number             String
  roomId             String?             @map("room_id") @db.Uuid
  area               String?
  category           MaintenanceCategory
  priority           TaskPriority        @default(NORMAL)
  status             TicketStatus        @default(OPEN)
  title              String
  description        String              @default("")
  photos             Json                @default("[]")
  reportedById       String?             @map("reported_by_id") @db.Uuid
  reportedByName     String?             @map("reported_by_name")
  assigneeId         String?             @map("assignee_id") @db.Uuid
  assigneeName       String?             @map("assignee_name")
  vendorName         String?             @map("vendor_name")
  vendorPhone        String?             @map("vendor_phone")
  blocksRoom         Boolean             @default(false) @map("blocks_room")
  costKobo           BigInt?             @map("cost_kobo")
  resolutionNote     String?             @map("resolution_note")
  slaDueAt           DateTime            @map("sla_due_at") @db.Timestamptz(3)
  housekeepingTaskId String?             @map("housekeeping_task_id") @db.Uuid
  scheduleId         String?             @map("schedule_id") @db.Uuid
  startedAt          DateTime?           @map("started_at") @db.Timestamptz(3)
  resolvedAt         DateTime?           @map("resolved_at") @db.Timestamptz(3)
  closedAt           DateTime?           @map("closed_at") @db.Timestamptz(3)
  clientCreatedAt    DateTime?           @map("client_created_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property         Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room             Room?                    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  housekeepingTask HousekeepingTask?        @relation(fields: [housekeepingTaskId], references: [id], onDelete: SetNull)
  schedule         MaintenanceSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  events           MaintenanceTicketEvent[]
  blocks           RoomBlock[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([roomId])
  @@map("maintenance_tickets")
}

model MaintenanceTicketEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  kind      String
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  note      String?
  byId      String?  @map("by_id") @db.Uuid
  byName    String?  @map("by_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("maintenance_ticket_events")
}

/// Out-of-order window for a room: availability excludes every night it overlaps.
model RoomBlock {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  propertyId    String    @map("property_id") @db.Uuid
  roomId        String    @map("room_id") @db.Uuid
  roomTypeId    String    @map("room_type_id") @db.Uuid
  startsAt      DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime  @map("ends_at") @db.Timestamptz(3)
  reason        String
  ticketId      String?   @map("ticket_id") @db.Uuid
  createdById   String?   @map("created_by_id") @db.Uuid
  createdByName String?   @map("created_by_name")
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  ticket   MaintenanceTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt, endsAt])
  @@index([roomId])
  @@map("room_blocks")
}

model MaintenanceSchedule {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  propertyId String              @map("property_id") @db.Uuid
  title      String
  category   MaintenanceCategory
  priority   TaskPriority        @default(NORMAL)
  roomIds    String[]            @default([]) @map("room_ids") @db.Uuid
  area       String?
  everyDays  Int                 @map("every_days")
  nextDueAt  DateTime            @map("next_due_at") @db.Timestamptz(3)
  lastRunAt  DateTime?           @map("last_run_at") @db.Timestamptz(3)
  checklist  String[]            @default([])
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tickets  MaintenanceTicket[]

  @@index([tenantId, active, nextDueAt])
  @@map("maintenance_schedules")
}

/// Generator / diesel log.
model FuelLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  date         DateTime @db.Date
  litres       Float
  costKobo     BigInt   @map("cost_kobo")
  supplier     String   @default("")
  runHours     Float?   @map("run_hours")

enum ChannelProviderKind {
  ICAL
  CHANNEX
}

enum OtaChannel {
  AIRBNB
  BOOKING_COM
  EXPEDIA
  AGODA
  VRBO
  HOTELS_NG
  OTHER
}

enum ChannelConnectionStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum SyncDirection {
  PUSH
  PULL
  WEBHOOK
}

enum SyncKind {
  ARI
  BOOKING
  ICAL_IMPORT
  CONNECT
  MAPPING
}

enum SyncStatus {
  OK
  ERROR
  SKIPPED
}

enum ChannelBookingStatus {
  NEW
  MODIFIED
  CANCELLED
}

model ChannelConnection {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  propertyId         String                  @map("property_id") @db.Uuid
  provider           ChannelProviderKind
  name               String
  channel            OtaChannel?
  status             ChannelConnectionStatus @default(ACTIVE)
  mock               Boolean                 @default(false)
  externalPropertyId String?                 @map("external_property_id")
  /// AES-256-GCM (GUEST_DATA_KEY), tenant id as associated data.
  apiKeyEnc          String?                 @map("api_key_enc")
  /// { stopSellBuffer, commissionBps, pushRates, pushRestrictions, horizonDays }
  settings           Json                    @default("{}")
  /// Bumped to invalidate every iCal export URL of the connection.
  icalVersion        Int                     @default(1) @map("ical_version")
  /// Last pushed ARI values: { "<roomTypeId>|<date>": "<hash>" }.
  ariState           Json                    @default("{}") @map("ari_state")
  ariDirtySince      DateTime?               @map("ari_dirty_since") @db.Timestamptz(3)
  ariDirtyFrom       DateTime?               @map("ari_dirty_from") @db.Date
  ariDirtyTo         DateTime?               @map("ari_dirty_to") @db.Date
  lastSyncAt         DateTime?               @map("last_sync_at") @db.Timestamptz(3)
  lastError          String?                 @map("last_error")
  lastErrorAt        DateTime?               @map("last_error_at") @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feeds    IcalFeed[]
  mappings ChannelMapping[]
  logs     ChannelSyncLog[]
  bookings ChannelBooking[]

  @@index([tenantId])
  @@index([propertyId])
  @@map("channel_connections")
}

model IcalFeed {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  propertyId    String    @map("property_id") @db.Uuid
  connectionId  String    @map("connection_id") @db.Uuid
  roomId        String?   @map("room_id") @db.Uuid
  roomTypeId    String    @map("room_type_id") @db.Uuid
  url           String
  lastFetchedAt DateTime? @map("last_fetched_at") @db.Timestamptz(3)
  lastStatus    String?   @map("last_status")
  lastError     String?   @map("last_error")
  eventsCount   Int       @default(0) @map("events_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([connectionId])
  @@map("ical_feeds")
}

model ChannelMapping {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  propertyId           String   @map("property_id") @db.Uuid
  connectionId         String   @map("connection_id") @db.Uuid
  roomTypeId           String   @map("room_type_id") @db.Uuid
  ratePlanId           String?  @map("rate_plan_id") @db.Uuid
  externalRoomTypeId   String   @map("external_room_type_id")
  externalRoomTypeName String?  @map("external_room_type_name")
  externalRatePlanId   String?  @map("external_rate_plan_id")
  externalRatePlanName String?  @map("external_rate_plan_name")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([connectionId])
  @@map("channel_mappings")
}

model ChannelSyncLog {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  propertyId   String        @map("property_id") @db.Uuid
  connectionId String        @map("connection_id") @db.Uuid
  direction    SyncDirection
  kind         SyncKind
  status       SyncStatus
  summary      String
  items        Int           @default(0)
  error        String?
  payload      Json?
  startedAt    DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?     @map("finished_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([connectionId, startedAt(sort: Desc)])
  @@index([propertyId, startedAt(sort: Desc)])
  @@map("channel_sync_logs")
}

model ChannelBooking {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  propertyId     String               @map("property_id") @db.Uuid
  connectionId   String               @map("connection_id") @db.Uuid
  provider       ChannelProviderKind
  channel        OtaChannel
  externalId     String               @map("external_id")
  revisionId     String?              @map("revision_id")
  status         ChannelBookingStatus @default(NEW)
  reservationId  String?              @map("reservation_id") @db.Uuid
  grossKobo      BigInt?              @map("gross_kobo")
  commissionKobo BigInt?              @map("commission_kobo")
  commissionBps  Int?                 @map("commission_bps")
  overbooked     Boolean              @default(false)
  raw            Json                 @default("{}")
  receivedAt     DateTime             @default(now()) @map("received_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

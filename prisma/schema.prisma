  number          String
  year            Int
  seq             Int
  issuedAt        DateTime         @default(now()) @map("issued_at") @db.Timestamptz(3)
  businessDate    DateTime         @map("business_date") @db.Date
  totalKobo       BigInt           @map("total_kobo")
  balanceKobo     BigInt           @map("balance_kobo")
  guestName       String?          @map("guest_name")
  reservationCode String?          @map("reservation_code")
  /// Snapshot of the printable document at issue time.
  document        Json
  issuedById      String?          @map("issued_by_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

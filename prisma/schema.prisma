// ===========================================================================

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  NOTE
  SYSTEM
}

enum TaskSuggestionStatus {
  PENDING
  CREATED
  DISMISSED
}

model Conversation {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  propertyId     String             @map("property_id") @db.Uuid
  guestId        String?            @map("guest_id") @db.Uuid
  guestPhone     String             @map("guest_phone")
  guestName      String             @map("guest_name")
  reservationId  String?            @map("reservation_id") @db.Uuid
  status         ConversationStatus @default(OPEN)
  assigneeId     String?            @map("assignee_id") @db.Uuid
  assigneeName   String?            @map("assignee_name")
  lastMessageAt  DateTime           @default(now()) @map("last_message_at") @db.Timestamptz(3)
  lastInboundAt  DateTime?          @map("last_inbound_at") @db.Timestamptz(3)
  lastOutboundAt DateTime?          @map("last_outbound_at") @db.Timestamptz(3)
  lastPreview    String             @default("") @map("last_preview")
  lastDirection  MessageDirection?  @map("last_direction")
  unreadCount    Int                @default(0) @map("unread_count")

  guest        Guest                @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tier         LoyaltyTier?         @relation(fields: [tierId], references: [id], onDelete: SetNull)
  transactions LoyaltyTransaction[]

  @@unique([tenantId, memberNo])
  @@index([tenantId, tierId])
  @@map("loyalty_members")
}

model LoyaltyTransaction {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  memberId       String         @map("member_id") @db.Uuid
  type           LoyaltyTxnType
  points         Int
  balanceAfter   Int            @map("balance_after")
  description    String
  reason         String?
  propertyId     String?        @map("property_id") @db.Uuid
  reservationId  String?        @map("reservation_id") @db.Uuid
  folioId        String?        @map("folio_id") @db.Uuid
  folioEntryId   String?        @map("folio_entry_id") @db.Uuid
  /// EARN lots: when they expire and how much is left (FIFO).
  expiresAt      DateTime?      @map("expires_at") @db.Timestamptz(3)
  remaining      Int            @default(0)
  /// Idempotency of automatic postings, e.g. "EARN:<reservationId>".
  dedupeKey      String?        @unique @map("dedupe_key")
  createdById    String?        @map("created_by_id") @db.Uuid
  createdByName  String?        @map("created_by_name")
  approvedById   String?        @map("approved_by_id") @db.Uuid
  approvedByName String?        @map("approved_by_name")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([memberId, createdAt])
  @@index([type, expiresAt])
  @@map("loyalty_transactions")
}

model LoyaltyChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  memberId   String    @map("member_id") @db.Uuid

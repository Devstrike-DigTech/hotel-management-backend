enum RatePlanKind {
  BAR
  NON_REFUNDABLE
  CORPORATE
  LONG_STAY
  PACKAGE
}

enum RatePlanPricing {
  DERIVED
  FIXED
}

enum AdjustmentType {
  PERCENT
  AMOUNT
  FIXED
}

model RatePlan {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  propertyId        String          @map("property_id") @db.Uuid
  code              String
  name              String
  description       String          @default("")
  kind              RatePlanKind
  isBar             Boolean         @default(false) @map("is_bar")
  pricing           RatePlanPricing @default(DERIVED)
  adjustmentType    AdjustmentType? @map("adjustment_type")
  adjustmentValue   Int?            @map("adjustment_value")
  /// { roomTypeId, rateKobo }[]
  fixedPrices       Json            @default("[]") @map("fixed_prices")
  /// { nonRefundable, freeCancellationHours, lateCancellationFeePct } or null (hotel policy)
  cancelPolicy      Json?           @map("cancel_policy")
  minNights         Int?            @map("min_nights")
  maxNights         Int?            @map("max_nights")
  includesBreakfast Boolean         @default(false) @map("includes_breakfast")
  channels          String[]        @default(["FRONT_DESK", "BOOKING_SITE", "MARKETPLACE"])
  roomTypeIds       String[]        @default([]) @map("room_type_ids") @db.Uuid
  active            Boolean         @default(true)
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations      Reservation[]
  corporateAccounts CorporateAccount[]

  @@unique([propertyId, code])
  @@index([tenantId])
  @@index([propertyId])
  @@map("rate_plans")
}

model RateRule {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  propertyId      String         @map("property_id") @db.Uuid
  name            String
  roomTypeIds     String[]       @default([]) @map("room_type_ids") @db.Uuid
  dateFrom        DateTime       @map("date_from") @db.Date
  dateTo          DateTime       @map("date_to") @db.Date
  daysOfWeek      Int[]          @default([]) @map("days_of_week")
  adjustmentType  AdjustmentType @map("adjustment_type")
  adjustmentValue Int            @map("adjustment_value")
  priority        Int            @default(0)
  color           String         @default("brass")
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, dateFrom, dateTo])
  @@map("rate_rules")
}

/// Single-date BAR price for a room type (the rates calendar).
model RateOverride {
  tenantId      String   @map("tenant_id") @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  roomTypeId    String   @map("room_type_id") @db.Uuid
  date          DateTime @db.Date
  rateKobo      Int      @map("rate_kobo")
  /// M5: MANUAL (rates calendar) or PRICING (dynamic pricing; never overwrites MANUAL).
  source        String   @default("MANUAL")
  note          String?
  updatedById   String?  @map("updated_by_id") @db.Uuid
  updatedByName String?  @map("updated_by_name")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, date])
  @@index([tenantId, date])
  @@map("rate_overrides")
}

/// Per-date restriction; roomTypeId null = every room type.
model RateRestriction {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  propertyId        String   @map("property_id") @db.Uuid
  roomTypeId        String?  @map("room_type_id") @db.Uuid
  date              DateTime @db.Date
  closedToArrival   Boolean  @default(false) @map("closed_to_arrival")
  closedToDeparture Boolean  @default(false) @map("closed_to_departure")
  stopSell          Boolean  @default(false) @map("stop_sell")
  minNights         Int?     @map("min_nights")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("rate_restrictions")
}

enum PromoType {
  PERCENT
  AMOUNT
  FREE_NIGHT
}

enum PromoRedemptionStatus {
  HELD
  CONFIRMED
  RELEASED
}

model PromoCode {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  code             String
  description      String    @default("")
  type             PromoType
  value            Int
  validFrom        DateTime? @map("valid_from") @db.Date
  validTo          DateTime? @map("valid_to") @db.Date
  stayFrom         DateTime? @map("stay_from") @db.Date
  stayTo           DateTime? @map("stay_to") @db.Date
  minNights        Int?      @map("min_nights")
  maxUses          Int?      @map("max_uses")
  perGuestLimit    Int?      @map("per_guest_limit")
  channels         String[]  @default(["FRONT_DESK", "BOOKING_SITE", "MARKETPLACE"])
  roomTypeIds      String[]  @default([]) @map("room_type_ids") @db.Uuid
  firstBookingOnly Boolean   @default(false) @map("first_booking_only")
  /// M5: properties where the code is valid (empty = every property of the group).
  propertyIds      String[]  @default([]) @map("property_ids") @db.Uuid
  active           Boolean   @default(true)
  uses             Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  redemptions  PromoRedemption[]

  @@unique([tenantId, code])
  @@map("promo_codes")
}

model PromoRedemption {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  promoCodeId   String                @map("promo_code_id") @db.Uuid
  reservationId String                @unique @map("reservation_id") @db.Uuid
  guestPhone    String?               @map("guest_phone")
  channel       String
  status        PromoRedemptionStatus @default(HELD)
  discountKobo  BigInt                @map("discount_kobo")
  nights        Int                   @default(1)
  confirmedAt   DateTime?             @map("confirmed_at") @db.Timestamptz(3)
  releasedAt    DateTime?             @map("released_at") @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promoCode   PromoCode   @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([promoCodeId, status])
  @@index([tenantId, guestPhone])
  @@map("promo_redemptions")
}

enum BillingCycle {
  PER_STAY
  MONTHLY
}

enum CityLedgerInvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum CityLedgerInvoiceKind {
  PER_STAY
  STATEMENT
}

enum LedgerPaymentMethod {
  TRANSFER
  CHEQUE
  CASH
  POS
}

model CorporateAccount {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  name             String
  contactName      String       @default("") @map("contact_name")
  email            String
  phone            String       @default("")
  address          String       @default("")
  taxId            String       @default("") @map("tax_id")
  ratePlanId       String?      @map("rate_plan_id") @db.Uuid
  creditLimitKobo  BigInt       @map("credit_limit_kobo")
  paymentTermsDays Int          @default(30) @map("payment_terms_days")
  billingCycle     BillingCycle @default(MONTHLY) @map("billing_cycle")
  active           Boolean      @default(true)
  notes            String       @default("")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ratePlan     RatePlan?           @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  charges      CityLedgerCharge[]
  invoices     CityLedgerInvoice[]
  payments     CityLedgerPayment[]

  @@unique([tenantId, name])
  @@map("corporate_accounts")
}

model CityLedgerCharge {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  /// M5: property where the charge arose.
  propertyId      String?  @map("property_id") @db.Uuid
  reservationId   String?  @map("reservation_id") @db.Uuid
  folioId         String?  @map("folio_id") @db.Uuid
  folioEntryId    String?  @map("folio_entry_id") @db.Uuid
  date            DateTime @db.Date
  description     String
  amountKobo      BigInt   @map("amount_kobo")
  guestName       String?  @map("guest_name")
  reservationCode String?  @map("reservation_code")
  invoiceId       String?  @map("invoice_id") @db.Uuid
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account     CorporateAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reservation Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  invoice     CityLedgerInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([accountId, invoiceId])
  @@index([tenantId, date])
  @@map("city_ledger_charges")
}

model CityLedgerInvoice {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  accountId      String                  @map("account_id") @db.Uuid
  number         String
  year           Int
  seq            Int
  kind           CityLedgerInvoiceKind
  periodFrom     DateTime?               @map("period_from") @db.Date
  periodTo       DateTime?               @map("period_to") @db.Date
  issueDate      DateTime                @map("issue_date") @db.Date
  dueDate        DateTime                @map("due_date") @db.Date
  totalKobo      BigInt                  @map("total_kobo")
  paidKobo       BigInt                  @default(0) @map("paid_kobo")
  status         CityLedgerInvoiceStatus @default(OPEN)
  notes          String                  @default("")
  issuedById     String?                 @map("issued_by_id") @db.Uuid
  issuedByName   String?                 @map("issued_by_name")
  remindersSent  Int                     @default(0) @map("reminders_sent")
  lastReminderAt DateTime?               @map("last_reminder_at") @db.Timestamptz(3)
  voidedAt       DateTime?               @map("voided_at") @db.Timestamptz(3)
  voidReason     String?                 @map("void_reason")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account     CorporateAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  charges     CityLedgerCharge[]
  allocations CityLedgerAllocation[]

  @@unique([tenantId, number])
  @@index([accountId, status])
  @@map("city_ledger_invoices")
}

model CityLedgerPayment {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  amountKobo     BigInt              @map("amount_kobo")
  method         LedgerPaymentMethod
  reference      String?
  receivedAt     DateTime            @map("received_at") @db.Timestamptz(3)
  note           String?
  recordedById   String?             @map("recorded_by_id") @db.Uuid
  recordedByName String?             @map("recorded_by_name")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account     CorporateAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  allocations CityLedgerAllocation[]

  @@index([accountId, receivedAt])
  @@map("city_ledger_payments")
}

model CityLedgerAllocation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  invoiceId  String   @map("invoice_id") @db.Uuid
  amountKobo BigInt   @map("amount_kobo")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment CityLedgerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice CityLedgerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentId])
  @@map("city_ledger_allocations")
}

/// Alert and quiet-hours settings per property (digest recipients stay in digest_settings).
model NotificationSetting {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  propertyId  String   @unique @map("property_id") @db.Uuid
  guardAlerts Json     @default("{}") @map("guard_alerts")
  quietHours  Json     @default("{}") @map("quiet_hours")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("notification_settings")
}

enum GuardAlertStatus {
  PENDING
  SENT
  DEFERRED
  FAILED
  ACKNOWLEDGED
}

/// A WhatsApp alert to owners / managers about one or more HIGH flags.
model GuardAlert {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  status             GuardAlertStatus @default(PENDING)
  urgent             Boolean          @default(false)
  flagIds            String[]         @default([]) @map("flag_ids") @db.Uuid
  recipients         String[]         @default([])
  recipientUserIds   String[]         @default([]) @map("recipient_user_ids") @db.Uuid
  scheduledFor       DateTime         @map("scheduled_for") @db.Timestamptz(3)
  sentAt             DateTime?        @map("sent_at") @db.Timestamptz(3)
  deferredReason     String?          @map("deferred_reason")
  acknowledgedAt     DateTime?        @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById   String?          @map("acknowledged_by_id") @db.Uuid
  acknowledgedByName String?          @map("acknowledged_by_name")
  error              String?
  test               Boolean          @default(false)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, scheduledFor])
  @@map("guard_alerts")
}

/// Inbound WhatsApp messages (platform level; hotel_platform only).
model WhatsAppInbound {
  id        String    @id @default(uuid()) @db.Uuid
  messageId String    @unique @map("message_id")
  fromPhone String    @map("from_phone")
  body      String    @default("")
  tenantId  String?   @map("tenant_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  command   String?
  result    String?
  handledAt DateTime? @map("handled_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([fromPhone, createdAt])
  @@map("whatsapp_inbound")
}


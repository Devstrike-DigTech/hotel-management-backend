model WebhookEndpoint {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  url                     String
  description             String?
  events                  String[]  @default([])
  /// Empty = every property.
  propertyIds             String[]  @default([]) @map("property_ids")
  status                  String    @default("ACTIVE")
  disabledReason          String?   @map("disabled_reason")
  disabledAt              DateTime? @map("disabled_at") @db.Timestamptz(3)
  secretEnc               String    @map("secret_enc")
  secretLast4             String    @map("secret_last4")
  previousSecretEnc       String?   @map("previous_secret_enc")
  previousSecretExpiresAt DateTime? @map("previous_secret_expires_at") @db.Timestamptz(3)
  secretRotatedAt         DateTime? @map("secret_rotated_at") @db.Timestamptz(3)
  failingSince            DateTime? @map("failing_since") @db.Timestamptz(3)
  consecutiveFailures     Int       @default(0) @map("consecutive_failures")
  lastSuccessAt           DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastFailureAt           DateTime? @map("last_failure_at") @db.Timestamptz(3)
  createdById             String?   @map("created_by_id") @db.Uuid
  createdByName           String?   @map("created_by_name")
  apiKeyId                String?   @map("api_key_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  endpointId      String    @map("endpoint_id") @db.Uuid
  eventId         String    @map("event_id")
  eventType       String    @map("event_type")
  propertyId      String?   @map("property_id") @db.Uuid
  payload         Json
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  nextAttemptAt   DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  lastAttemptAt   DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)
  responseStatus  Int?      @map("response_status")
  durationMs      Int?      @map("duration_ms")
  error           String?
  requestHeaders  Json?     @map("request_headers")
  responseHeaders Json?     @map("response_headers")
  responseBody    String?   @map("response_body")
  attemptLog      Json      @default("[]") @map("attempt_log")
  isTest          Boolean   @default(false) @map("is_test")
  replayOf        String?   @map("replay_of") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

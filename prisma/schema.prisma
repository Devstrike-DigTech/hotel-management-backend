  redemptions    Int       @default(0)
  validFrom      DateTime? @map("valid_from") @db.Timestamptz(3)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(3)
  active         Boolean   @default(true)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdByName  String?   @map("created_by_name")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenantRedemptions CouponRedemption[]

  @@map("coupons")
}

/// A coupon applied to a tenant's subscription (one active per tenant).
model CouponRedemption {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  couponId        String    @map("coupon_id") @db.Uuid
  /// Billing months still discounted (null = forever).
  monthsRemaining Int?      @map("months_remaining")
  active          Boolean   @default(true)
  appliedAt       DateTime  @default(now()) @map("applied_at") @db.Timestamptz(3)
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([couponId])
  @@map("coupon_redemptions")
}

model Announcement {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  body            String
  severity        String    @default("INFO")
  /// { kind: ALL | PLANS | CITIES | TENANTS, planCodes?, cities?, tenantIds? }
  audience        Json      @default("{\"kind\":\"ALL\"}")
  inApp           Boolean   @default(true) @map("in_app")
  email           Boolean   @default(false)
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(3)
  dismissible     Boolean   @default(true)
  linkLabel       String?   @map("link_label")
  linkUrl         String?   @map("link_url")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(3)

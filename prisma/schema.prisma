/// Where a tenant's data lives. No row (or mode SHARED) = the shared database.
model TenantDatabase {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @unique @map("tenant_id") @db.Uuid
  mode            String    @default("SHARED")
  status          String?
  /// AES-256-GCM (PLATFORM_DATA_KEY) of the owner-role URL.
  urlEnc          String?   @map("url_enc")
  /// Optional explicit runtime URLs; default: DATABASE_URL / DATABASE_PLATFORM_URL with this host and database.
  appUrlEnc       String?   @map("app_url_enc")
  platformUrlEnc  String?   @map("platform_url_enc")
  dbName          String?   @map("db_name")
  host            String?
  createdByUs     Boolean   @default(false) @map("created_by_us")
  version         String?
  lastMigratedAt  DateTime? @map("last_migrated_at") @db.Timestamptz(3)
  activatedAt     DateTime? @map("activated_at") @db.Timestamptz(3)
  readOnlyUntil   DateTime? @map("read_only_until") @db.Timestamptz(3)
  sharedPurgeAfter DateTime? @map("shared_purge_after") @db.Timestamptz(3)
  sharedPurgedAt  DateTime? @map("shared_purged_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tenant_databases")
}


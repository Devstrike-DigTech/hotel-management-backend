# ---------------------------------------------------------------------------
# Product identity. The product name is NOT final: never hard-code it.
# ---------------------------------------------------------------------------
APP_NAME="HotelOS"
APP_DOMAIN=hotelos.ng
SUPPORT_EMAIL=support@hotelos.ng

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Public URLs of the two frontends (used for payment callbacks / mock checkout).
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The API connects as the restricted runtime role (NOSUPERUSER NOBYPASSRLS),
# so PostgreSQL row-level security is enforced.
DATABASE_URL=postgresql://hotel_app:hotel_app@localhost:5432/hotel
# Cross-tenant work (platform console, Paystack webhooks, scheduled jobs) uses
# a separate restricted role whose access comes from its own RLS policies.
DATABASE_PLATFORM_URL=postgresql://hotel_platform:hotel_platform@localhost:5432/hotel
DATABASE_PLATFORM_POOL_MAX=4
# HMAC key that signs the per-transaction tenant context. The API installs it
# in the database at start-up; every instance must use the same value.
DB_CONTEXT_SECRET=change-me-db-context-secret-at-least-32-characters
# Migrations and seeding run as the schema owner.
DATABASE_MIGRATION_URL=postgresql://hotel:hotel@localhost:5432/hotel
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth: use long random values in every real environment (min 32 chars), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_PLATFORM_SECRET=change-me-platform-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Requests per minute per IP on the login/signup/refresh endpoints.
AUTH_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# Guest data and documents
# ---------------------------------------------------------------------------
# Key material for AES-256-GCM encryption of guest ID numbers (the key is
# SHA-256 of this value). Changing it makes existing ID numbers unreadable.
GUEST_DATA_KEY=change-me-guest-data-key-at-least-32-characters
# Signs invoice/receipt share links and short-lived file URLs.
SHARE_TOKEN_SECRET=change-me-share-token-secret-at-least-32-characters
# Public base URL of this API, used in signed ID-image URLs.
API_PUBLIC_URL=http://localhost:4000
# Object storage for guest ID images: local (a directory) or s3 (any
# S3-compatible service: AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Owner digest over WhatsApp Cloud API. Leave empty to log and store only.
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0

# ---------------------------------------------------------------------------
# Payments (Paystack). Leave empty in development to use the mock checkout.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ---------------------------------------------------------------------------
# Background jobs and docs
# ---------------------------------------------------------------------------
JOBS_ENABLED=true
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Product identity. The product name is NOT final: never hard-code it.
# ---------------------------------------------------------------------------
APP_NAME="HotelOS"
APP_DOMAIN=hotelos.ng
SUPPORT_EMAIL=support@hotelos.ng

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# M6: the ONLY browser origins allowed on /api/v1/platform/* (the platform
# console, its own app). CORS_ORIGINS are refused there with 403
# ORIGIN_NOT_ALLOWED, and these origins are refused on hotel routes.
PLATFORM_ORIGINS=http://localhost:3002
# Console base URL for invitation links (default: first PLATFORM_ORIGINS entry).
PLATFORM_APP_URL=http://localhost:3002
# Public URLs of the two frontends (used for payment callbacks / mock checkout).
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The API connects as the restricted runtime role (NOSUPERUSER NOBYPASSRLS),
# so PostgreSQL row-level security is enforced.
DATABASE_URL=postgresql://hotel_app:hotel_app@localhost:5432/hotel
# Cross-tenant work (platform console, Paystack webhooks, scheduled jobs) uses
# a separate restricted role whose access comes from its own RLS policies.
DATABASE_PLATFORM_URL=postgresql://hotel_platform:hotel_platform@localhost:5432/hotel
DATABASE_PLATFORM_POOL_MAX=4
# HMAC key that signs the per-transaction tenant context. The API installs it
# in the database at start-up; every instance must use the same value.
DB_CONTEXT_SECRET=change-me-db-context-secret-at-least-32-characters
# Migrations and seeding run as the schema owner.
DATABASE_MIGRATION_URL=postgresql://hotel:hotel@localhost:5432/hotel
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth: use long random values in every real environment (min 32 chars), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_PLATFORM_SECRET=change-me-platform-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Requests per minute per IP on the login/signup/refresh endpoints.
AUTH_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# Guest data and documents
# ---------------------------------------------------------------------------
# Key material for AES-256-GCM encryption of guest ID numbers (the key is
# SHA-256 of this value). Changing it makes existing ID numbers unreadable.
GUEST_DATA_KEY=change-me-guest-data-key-at-least-32-characters
# Signs invoice/receipt share links and short-lived file URLs.
SHARE_TOKEN_SECRET=change-me-share-token-secret-at-least-32-characters
# Public base URL of this API, used in signed ID-image URLs.
API_PUBLIC_URL=http://localhost:4000
# Object storage for guest ID images: local (a directory) or s3 (any
# S3-compatible service: AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Guest accounts and guest links (M3)
# ---------------------------------------------------------------------------
# Signs guest access tokens (JWT audience "guest"); different from the staff secret.
GUEST_JWT_SECRET=change-me-guest-jwt-secret-at-least-32-characters
# Signs quote tokens, manage-booking links, review links, magic links and OTP hashes.
GUEST_TOKEN_SECRET=change-me-guest-token-secret-at-least-32-characters
GUEST_ACCESS_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Notifications. With no provider configured, development captures every
# message in the dev outbox (GET /api/v1/public/dev/outbox); production marks
# it FAILED ("provider not configured").
# ---------------------------------------------------------------------------
# Sender for guest and hotel email, e.g. "HotelOS <bookings@hotelos.ng>".
EMAIL_FROM="HotelOS <bookings@hotelos.ng>"
# Resend (preferred when set) ...
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
# ... or SMTP via nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# SMS through Termii (sender ID must be registered with Termii).
TERMII_API_KEY=
TERMII_SENDER_ID=HotelOS
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=generic
# Orphaned-payment alerts for the platform team (defaults to SUPPORT_EMAIL).
PLATFORM_ALERT_EMAIL=
# Redis rate limits on public booking, quote and OTP endpoints.
PUBLIC_RATE_LIMITS=true

# ---------------------------------------------------------------------------
# WhatsApp Cloud API: owner digest (M2) and guest messages for hotels with
# whatsapp_messaging, plus WhatsApp OTP. Leave empty to log / use the outbox.
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
# M4 inbound webhook (owner replies "1" / "DIGEST"): point Meta at
# ${API_PUBLIC_URL}/api/v1/webhooks/whatsapp. The app secret verifies
# X-Hub-Signature-256 (empty = every delivery is rejected); the verify token
# answers Meta's subscription check.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Comma-separated template names Meta has approved (docs/whatsapp-templates.md).
WHATSAPP_APPROVED_TEMPLATES=

# ---------------------------------------------------------------------------
# Channel manager (M5, Pro). With CHANNEX_API_KEY empty, Channex connections use
# an in-process mock (development only: the API refuses to start in production
# without a key). Point the Channex webhook at
# ${API_PUBLIC_URL}/api/v1/webhooks/channex and give it the same secret; an
# empty secret rejects every delivery. iCal feeds are re-imported every
# ICAL_POLL_MINUTES (5-1440).
# ---------------------------------------------------------------------------
CHANNEX_API_KEY=
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_WEBHOOK_SECRET=dev-channex-webhook-secret
ICAL_POLL_MINUTES=15
# Feed URLs are fetched under an SSRF guard: https only in production, every
# resolved address must be public (no loopback, private, link-local / metadata,
# CGNAT, multicast; IPv4 and IPv6), the socket is pinned to the vetted address,
# redirects are re-checked (max 3), 2 MB / 10 s caps, text/calendar or
# text/plain only. Development only: hostnames exempt from the address check
# (e.g. localhost for a local feed stub). Must be empty in production.
OUTBOUND_ALLOW_PRIVATE_HOSTS=

# ---------------------------------------------------------------------------
# Custom domains (M5, Pro). Hotels add a TXT record and CNAME their subdomain
# to CUSTOM_DOMAIN_TARGET (default sites.<APP_DOMAIN>). DNS_PROVIDER=system
# uses node:dns; mock (the default outside production) is an in-memory table
# with dev endpoints to publish records.
# ---------------------------------------------------------------------------
DNS_PROVIDER=mock
CUSTOM_DOMAIN_TARGET=

# ---------------------------------------------------------------------------
# Trusted client IP (M4). The web server sends the visitor's IP in X-Client-IP
# with X-Proxy-Auth = this secret; only then is X-Client-IP used for rate
# limits. Same value in the web app. Empty = off; at least 16 characters.
# ---------------------------------------------------------------------------
TRUSTED_PROXY_SECRET=

# ---------------------------------------------------------------------------
# Payments (Paystack): subscriptions (M1) and guest bookings with split
# payments to hotel subaccounts (M3). Leave empty in development to use the
# mock checkout pages, mock banks and mock subaccounts. Point the Paystack
# dashboard webhook at ${API_PUBLIC_URL}/api/v1/billing/webhooks/paystack.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ---------------------------------------------------------------------------
# Enterprise tier (M6)
# ---------------------------------------------------------------------------
# Key material for platform secrets at rest (TOTP secrets, dedicated database
# URLs, SSO client secrets, webhook signing secrets); at least 32 characters.
# Empty = derived from GUEST_DATA_KEY. Never rotate without re-encrypting.
PLATFORM_DATA_KEY=
# Owner-role URL with CREATEDB for dedicated tenant databases and
# `pnpm db:migrate:all`. Empty outside production = DATABASE_MIGRATION_URL.
# Empty in production = operators create the database and paste its URL.
DATABASE_ADMIN_URL=
DEDICATED_DB_PREFIX=hotel_t_
DEDICATED_DB_MAX_CLIENTS=20
DEDICATED_DB_POOL_MAX=3
DEDICATED_SHARED_RETENTION_DAYS=7
# White-label staff portal domains CNAME here (default portal.<APP_DOMAIN>).
# Email sending domains use RESEND_API_KEY above (mock without it); SMS
# sender IDs use TERMII_API_KEY (mock without it).
STAFF_PORTAL_TARGET=
# Development OIDC provider at /api/v1/dev/oidc (client dev-client /
# dev-secret). Default on outside production; refused in production.
OIDC_MOCK_ENABLED=true
WEBHOOK_TIMEOUT_MS=10000
PARTNER_RATE_LIMIT_ENTERPRISE=600
PARTNER_RATE_LIMIT_DEFAULT=120
OFFBOARDING_GRACE_DAYS=30

# ---------------------------------------------------------------------------
# Background jobs and docs
# ---------------------------------------------------------------------------
JOBS_ENABLED=true
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# M7: Brand Studio, booking forms, extras and pickups
# ---------------------------------------------------------------------------
# No new variables. Site assets and booking-form uploads use the storage
# driver above (STORAGE_DRIVER / STORAGE_LOCAL_DIR); preview links and
# upload tokens are signed with SHARE_TOKEN_SECRET; the "View your site" link
# uses WEB_URL. Uploaded files pass through a FileScanner interface (a
# no-op that refuses the EICAR test string); bind a real scanner in
# SiteModule (FILE_SCANNER) to scan in production.
